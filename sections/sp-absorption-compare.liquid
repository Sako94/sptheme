{%- comment -%}
  SoftPauses pill vs patch absorption comparison. Two SVG curves over a
  24-hour x-axis: pill (spike + crash, repeating) vs patch (sustained line).
{%- endcomment -%}

<style>
  #shopify-section-{{ section.id }} { background: var(--sp-blush-soft); }
  .sp-abs { padding-top: var(--sp-pad-top, 96px); padding-bottom: var(--sp-pad-bottom, 96px); }
  @media (max-width: 720px) { .sp-abs { padding-top: 64px; padding-bottom: 64px; } }
  .sp-abs__head { text-align: center; margin-bottom: 36px; }
  .sp-abs__head h2 { margin-bottom: 14px; }
  .sp-abs__head p { color: var(--sp-ink-mid); max-width: 540px; margin: 0 auto; }

  .sp-abs__chart {
    background: var(--sp-cream);
    border-radius: 4px;
    padding: 36px 32px;
    max-width: 820px;
    margin: 0 auto;
  }
  @media (max-width: 600px) { .sp-abs__chart { padding: 24px 18px; } }
  .sp-abs__chart svg { width: 100%; height: auto; display: block; }
  .sp-abs__legend {
    display: flex;
    justify-content: center;
    gap: 32px;
    margin-top: 22px;
    flex-wrap: wrap;
    font-family: 'IBM Plex Sans', sans-serif;
    font-size: 13px;
  }
  .sp-abs__legend-item {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--sp-ink-mid);
  }
  .sp-abs__swatch {
    width: 24px;
    height: 3px;
    border-radius: 2px;
  }
  .sp-abs__swatch.is-patch { background: var(--sp-poppy); }
  .sp-abs__swatch.is-pill {
    background: transparent;
    border-bottom: 2px dashed var(--sp-ink-muted);
    height: 0;
  }
  .sp-abs__legend-item strong { color: var(--sp-ink); font-weight: 500; }
</style>

<section class="sp-abs"
  style="--sp-pad-top: {{ section.settings.pad_top }}px; --sp-pad-bottom: {{ section.settings.pad_bottom }}px;">
  <div class="sp-wrap">
    <div class="sp-abs__head">
      {%- if section.settings.kicker != blank -%}<span class="sp-kicker">{{ section.settings.kicker }}</span>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="sp-h2">{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.lede != blank -%}<p>{{ section.settings.lede }}</p>{%- endif -%}
    </div>

    <div class="sp-abs__chart">
      <svg viewBox="0 0 760 280" xmlns="http://www.w3.org/2000/svg" aria-label="Pill versus patch absorption over 24 hours">
        <!-- Y axis label -->
        <text x="14" y="22" font-family="IBM Plex Sans, sans-serif" font-size="10" letter-spacing="2" fill="#8A6E64">ACTIVE LEVEL</text>

        <!-- Y axis grid lines (subtle) -->
        <g stroke="#E8D5C5" stroke-width="0.5" opacity="0.7">
          <line x1="60" y1="60" x2="730" y2="60"/>
          <line x1="60" y1="120" x2="730" y2="120"/>
          <line x1="60" y1="180" x2="730" y2="180"/>
        </g>

        <!-- X axis -->
        <line x1="60" y1="220" x2="730" y2="220" stroke="#8A6E64" stroke-width="1"/>

        <!-- X axis hour labels -->
        <g font-family="IBM Plex Sans, sans-serif" font-size="11" fill="#8A6E64" text-anchor="middle">
          <text x="60" y="244">0h</text>
          <text x="228" y="244">6h</text>
          <text x="395" y="244">12h</text>
          <text x="562" y="244">18h</text>
          <text x="730" y="244">24h</text>
        </g>

        <!-- "Therapeutic window" band -->
        <rect x="60" y="100" width="670" height="60" fill="#FED9D1" opacity="0.35"/>
        <text x="68" y="116" font-family="IBM Plex Sans, sans-serif" font-size="9" letter-spacing="2" fill="#5C3A33">THERAPEUTIC WINDOW</text>

        <!-- PILL curve: spike + crash, repeating 4 times across 24h -->
        <path d="M 60 200
                 C 70 200, 100 60, 130 80
                 C 160 110, 180 200, 228 200
                 C 245 200, 270 70, 300 90
                 C 325 115, 345 200, 395 200
                 C 412 200, 435 70, 465 90
                 C 490 115, 510 200, 562 200
                 C 580 200, 605 60, 635 80
                 C 660 110, 685 200, 730 200"
              fill="none" stroke="#8A6E64" stroke-width="1.8" stroke-dasharray="4 5" stroke-linejoin="round" stroke-linecap="round"/>

        <!-- Pill dose markers -->
        <g fill="#8A6E64" opacity="0.85">
          <circle cx="60" cy="200" r="3"/>
          <circle cx="228" cy="200" r="3"/>
          <circle cx="395" cy="200" r="3"/>
          <circle cx="562" cy="200" r="3"/>
        </g>

        <!-- PATCH curve: smooth ramp + sustained plateau, gentle taper -->
        <path d="M 60 195
                 C 80 195, 100 130, 140 122
                 C 200 116, 280 116, 380 118
                 C 480 120, 570 124, 660 130
                 C 700 132, 720 138, 730 140"
              fill="none" stroke="#ED1B28" stroke-width="3" stroke-linejoin="round" stroke-linecap="round"/>

        <!-- Patch start marker -->
        <circle cx="60" cy="195" r="4" fill="#ED1B28"/>
      </svg>

      <div class="sp-abs__legend">
        <div class="sp-abs__legend-item">
          <span class="sp-abs__swatch is-patch"></span>
          <strong>{{ section.settings.legend_patch | default: 'soft pauses patch' }}</strong>
        </div>
        <div class="sp-abs__legend-item">
          <span class="sp-abs__swatch is-pill"></span>
          <strong>{{ section.settings.legend_pill | default: 'typical maca capsule' }}</strong>
        </div>
      </div>
    </div>

    {%- if section.settings.foot != blank -%}
      <p style="text-align: center; margin-top: 18px; font-family: 'IBM Plex Sans', sans-serif; font-size: 12px; color: var(--sp-ink-muted); max-width: 620px; margin-left: auto; margin-right: auto;">{{ section.settings.foot }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Absorption compare",
  "tag": "section",
  "class": "sp-absorption-section",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "absorption" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "steady release vs spike and crash." },
    { "type": "richtext", "id": "lede", "label": "Lede", "default": "<p>capsules dump everything at once. blood levels spike, then crash before your next dose. the patch holds you in the therapeutic window all day.</p>" },
    { "type": "text", "id": "legend_patch", "label": "Patch line legend", "default": "soft pauses patch" },
    { "type": "text", "id": "legend_pill", "label": "Pill line legend", "default": "typical maca capsule" },
    { "type": "text", "id": "foot", "label": "Footnote", "default": "Illustrative pharmacokinetic comparison based on transdermal vs oral release profiles. Not a clinical measurement of soft pauses specifically." },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "pad_top", "label": "Padding top", "min": 0, "max": 200, "step": 8, "unit": "px", "default": 96 },
    { "type": "range", "id": "pad_bottom", "label": "Padding bottom", "min": 0, "max": 200, "step": 8, "unit": "px", "default": 96 }
  ],
  "presets": [
    { "name": "Absorption compare" }
  ]
}
{% endschema %}
