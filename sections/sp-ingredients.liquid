{%- comment -%}
  SoftPauses ingredients grid. Each ingredient is a block with editable
  swatch color, name, dose, and description.
{%- endcomment -%}

<style>
  #shopify-section-{{ section.id }} { background: var(--sp-blush-soft); }
  .sp-ing { padding-top: var(--sp-pad-top, 96px); padding-bottom: var(--sp-pad-bottom, 96px); }
  @media (max-width: 720px) {
    .sp-ing { padding-top: 64px; padding-bottom: 64px; }
  }
  .sp-ing__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
    margin-top: 36px;
  }
  @media (max-width: 900px) { .sp-ing__grid { grid-template-columns: repeat(2, 1fr); } }
  .sp-ing__card {
    background: var(--sp-cream);
    padding: 22px;
    border-radius: 4px;
  }
  .sp-ing__swatch {
    aspect-ratio: 1 / 1;
    border-radius: 4px;
    margin-bottom: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'IBM Plex Sans', sans-serif;
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .sp-ing__card h4 {
    font-family: 'Fraunces', serif;
    font-size: 1.125rem;
    margin-bottom: 4px;
    text-transform: lowercase;
    font-weight: 500;
    color: var(--sp-ink);
    font-variation-settings: "opsz" 96;
  }
  .sp-ing__dose {
    font-family: 'IBM Plex Sans', sans-serif;
    font-size: 11px;
    color: var(--sp-poppy);
    letter-spacing: 0.06em;
    margin-bottom: 10px;
    font-weight: 500;
    text-transform: uppercase;
  }
  .sp-ing__card p {
    font-size: 0.875rem;
    color: var(--sp-ink-mid);
    line-height: 1.55;
    margin: 0;
  }
  .sp-ing__cta {
    margin-top: 26px;
    text-align: center;
  }
  .sp-ing__cta a {
    color: var(--sp-ink);
    border-bottom: 1px solid var(--sp-ink-muted);
    text-decoration: none;
    font-size: 14px;
    padding-bottom: 2px;
  }
  .sp-ing__cta a:hover { color: var(--sp-poppy); border-bottom-color: var(--sp-poppy); }
</style>

<section class="sp-ing"
  style="--sp-pad-top: {{ section.settings.pad_top }}px; --sp-pad-bottom: {{ section.settings.pad_bottom }}px;">
  <div class="sp-wrap">
    {%- if section.settings.chapter_label != blank or section.settings.chapter_num != blank -%}
      <div class="sp-chapter">
        <span class="sp-chapter__label">{{ section.settings.chapter_label }}</span>
        <span class="sp-chapter__num">{{ section.settings.chapter_num }}</span>
      </div>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}<h2 class="sp-h2">{{ section.settings.heading }}</h2>{%- endif -%}
    {%- if section.settings.lede != blank -%}<div class="sp-lede">{{ section.settings.lede }}</div>{%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="sp-ing__grid">
        {%- for block in section.blocks -%}
          <div class="sp-ing__card" {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
              <div class="sp-ing__swatch" style="overflow: hidden;">
                {{ block.settings.image | image_url: width: 400 | image_tag:
                  loading: 'lazy',
                  sizes: '(min-width: 900px) 220px, 50vw',
                  widths: '220, 440',
                  alt: block.settings.image.alt | default: block.settings.name,
                  style: 'width: 100%; height: 100%; object-fit: cover;'
                }}
              </div>
            {%- elsif block.settings.image_asset != blank -%}
              <div class="sp-ing__swatch" style="overflow: hidden;">
                <img src="{{ block.settings.image_asset | asset_url }}"
                     alt="{{ block.settings.name }}"
                     width="800"
                     height="800"
                     loading="lazy"
                     style="width: 100%; height: 100%; object-fit: cover;">
              </div>
            {%- else -%}
              <div class="sp-ing__swatch"
                style="background: linear-gradient(135deg, {{ block.settings.swatch_color_1 }}, {{ block.settings.swatch_color_2 }}); color: {{ block.settings.swatch_text_color }};">
                {{ block.settings.swatch_label }}
              </div>
            {%- endif -%}
            <h4>{{ block.settings.name }}</h4>
            {%- if block.settings.dose != blank -%}<div class="sp-ing__dose">{{ block.settings.dose }}</div>{%- endif -%}
            <p>{{ block.settings.description }}</p>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if section.settings.cta_text != blank -%}
      <div class="sp-ing__cta">
        <a href="{{ section.settings.cta_url | default: '#' }}">{{ section.settings.cta_text }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Ingredients",
  "tag": "section",
  "class": "sp-ingredients-section",
  "settings": [
    { "type": "text", "id": "chapter_label", "label": "Chapter label", "default": "what's in it" },
    { "type": "text", "id": "chapter_num", "label": "Chapter number", "default": "/ 03" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "four ingredients. clinical doses. nothing else." },
    { "type": "richtext", "id": "lede", "label": "Lede", "default": "<p>no fillers, no flavor agents, no proprietary blends, no marketing math. each patch delivers the same dose. every day.</p>" },
    { "type": "text", "id": "cta_text", "label": "CTA text", "default": "view full supplement facts panel →" },
    { "type": "url", "id": "cta_url", "label": "CTA link" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "pad_top", "label": "Padding top", "min": 0, "max": 200, "step": 8, "unit": "px", "default": 96 },
    { "type": "range", "id": "pad_bottom", "label": "Padding bottom", "min": 0, "max": 200, "step": 8, "unit": "px", "default": 96 }
  ],
  "blocks": [
    {
      "type": "ingredient",
      "name": "Ingredient",
      "settings": [
        { "type": "text", "id": "name", "label": "Name", "default": "black maca" },
        { "type": "text", "id": "dose", "label": "Dose / kicker", "default": "organic · andean" },
        { "type": "textarea", "id": "description", "label": "Description", "default": "the most-studied of the three. supports mental energy, focus, and the ability to actually finish a sentence again." },
        { "type": "header", "content": "Visual (image picker > theme asset > gradient swatch)" },
        { "type": "image_picker", "id": "image", "label": "Image (uploaded)" },
        { "type": "text", "id": "image_asset", "label": "Theme asset filename (fallback)", "info": "e.g. sp-ing-black-maca.png. Used only if no image is uploaded above." },
        { "type": "text", "id": "swatch_label", "label": "Swatch label", "default": "BLACK MACA" },
        { "type": "color", "id": "swatch_color_1", "label": "Swatch color (start)", "default": "#2A1410" },
        { "type": "color", "id": "swatch_color_2", "label": "Swatch color (end)", "default": "#5C3A33" },
        { "type": "color", "id": "swatch_text_color", "label": "Swatch label color", "default": "#FAF1EA" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Ingredients",
      "blocks": [
        { "type": "ingredient", "settings": { "name": "black maca", "dose": "organic · andean", "description": "the most-studied of the three. supports mental energy, focus, and the ability to actually finish a sentence again.", "swatch_label": "BLACK MACA", "swatch_color_1": "#2A1410", "swatch_color_2": "#5C3A33", "swatch_text_color": "#FAF1EA" } },
        { "type": "ingredient", "settings": { "name": "red maca", "dose": "organic · andean", "description": "traditionally used for hormonal balance. associated with mood support and hot-flash relief in clinical research.", "swatch_label": "RED MACA", "swatch_color_1": "#C8121E", "swatch_color_2": "#ED1B28", "swatch_text_color": "#FAF1EA" } },
        { "type": "ingredient", "settings": { "name": "yellow maca", "dose": "organic · andean", "description": "the most common variety. supports overall stamina and helps round out the full-spectrum extract.", "swatch_label": "YELLOW MACA", "swatch_color_1": "#C8862E", "swatch_color_2": "#E0A040", "swatch_text_color": "#2A1410" } },
        { "type": "ingredient", "settings": { "name": "black pepper extract", "dose": "bioperine® · standardized", "description": "increases absorption of the maca actives. without it, your body uses a fraction of what you take.", "swatch_label": "BIOPERINE", "swatch_color_1": "#1A0E0A", "swatch_color_2": "#2A1410", "swatch_text_color": "#FAF1EA" } }
      ]
    }
  ]
}
{% endschema %}
