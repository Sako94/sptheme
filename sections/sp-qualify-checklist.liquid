{%- comment -%}
  SoftPauses qualify checklist. "Is this for you?" — a 5–6 item list
  with checkbox-styled bullets that helps prospects self-segment.
{%- endcomment -%}

<style>
  #shopify-section-{{ section.id }} { background: var(--sp-cream); }
  .sp-qual { padding-top: var(--sp-pad-top, 96px); padding-bottom: var(--sp-pad-bottom, 96px); }
  @media (max-width: 720px) { .sp-qual { padding-top: 64px; padding-bottom: 64px; } }
  .sp-qual__list {
    list-style: none;
    margin: 32px 0 0;
    padding: 0;
    max-width: 620px;
  }
  .sp-qual__list li {
    padding: 18px 0 18px 36px;
    border-bottom: 1px solid var(--sp-rule);
    position: relative;
    font-family: 'Fraunces', serif;
    font-size: 1.1875rem;
    line-height: 1.4;
    color: var(--sp-ink);
    font-variation-settings: "opsz" 72;
    list-style: none;
  }
  .sp-qual__list li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 22px;
    width: 22px;
    height: 22px;
    border-radius: 3px;
    background: var(--sp-blush);
    border: 1.5px solid var(--sp-poppy);
  }
  .sp-qual__list li::after {
    content: "✓";
    position: absolute;
    left: 4px;
    top: 17px;
    font-family: 'IBM Plex Sans', sans-serif;
    font-size: 16px;
    font-weight: 600;
    color: var(--sp-poppy);
  }
  .sp-qual__list li:first-child { border-top: 1px solid var(--sp-rule); }
  .sp-qual__followup {
    margin-top: 28px;
    color: var(--sp-ink-mid);
    font-style: italic;
    font-family: 'Fraunces', serif;
    font-size: 1.0625rem;
    font-variation-settings: "opsz" 72;
    max-width: 620px;
  }
</style>

<section class="sp-qual"
  style="--sp-pad-top: {{ section.settings.pad_top }}px; --sp-pad-bottom: {{ section.settings.pad_bottom }}px;">
  <div class="sp-wrap sp-wrap--mid">
    {%- if section.settings.heading != blank -%}<h2 class="sp-h2">{{ section.settings.heading }}</h2>{%- endif -%}
    {%- if section.settings.lede != blank -%}<div class="sp-lede">{{ section.settings.lede }}</div>{%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <ul class="sp-qual__list">
        {%- for block in section.blocks -%}
          {%- if block.type == 'item' -%}
            <li {{ block.shopify_attributes }}>{{ block.settings.text }}</li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- if section.settings.followup != blank -%}
      <p class="sp-qual__followup">{{ section.settings.followup }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Qualify checklist",
  "tag": "section",
  "class": "sp-qualify-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "is this for you?" },
    { "type": "richtext", "id": "lede", "label": "Lede", "default": "<p>if any of these sound like you, the answer is probably yes.</p>" },
    { "type": "richtext", "id": "followup", "label": "Follow-up paragraph", "default": "<p>soft pauses is not magic and it is not a cure. it is daily support, taken consistently, that helps a lot of women feel more like themselves again.</p>" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "pad_top", "label": "Padding top", "min": 0, "max": 200, "step": 8, "unit": "px", "default": 96 },
    { "type": "range", "id": "pad_bottom", "label": "Padding bottom", "min": 0, "max": 200, "step": 8, "unit": "px", "default": 96 }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Checklist item",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "you're between 38 and 55 and your body has stopped doing what it used to." }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Qualify checklist",
      "blocks": [
        { "type": "item", "settings": { "text": "you're between 38 and 55 and your body has stopped doing what it used to." } },
        { "type": "item", "settings": { "text": "you wake up at 3am for no reason and can't fall back asleep." } },
        { "type": "item", "settings": { "text": "your labs came back 'normal' but you do not feel normal." } },
        { "type": "item", "settings": { "text": "you've been told it's stress, depression, or just getting older." } },
        { "type": "item", "settings": { "text": "you've tried three or more supplements that did nothing." } },
        { "type": "item", "settings": { "text": "you're not ready for HRT, or you're on it and want a daily floor of support." } }
      ]
    }
  ]
}
{% endschema %}
