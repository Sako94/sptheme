{%- comment -%}
  SoftPauses how it works. 3 steps: peel, stick, support.
  Each step is a block with an icon (built-in SVG selectable via select setting),
  a heading, and a body. Visual rhythm of the design.
{%- endcomment -%}

<style>
  #shopify-section-{{ section.id }} { background: var(--sp-cream); }
  .sp-hiw { padding-top: var(--sp-pad-top, 96px); padding-bottom: var(--sp-pad-bottom, 96px); }
  @media (max-width: 720px) { .sp-hiw { padding-top: 64px; padding-bottom: 64px; } }
  .sp-hiw__head { text-align: center; margin-bottom: 48px; }
  .sp-hiw__head h2 { margin-bottom: 14px; }
  .sp-hiw__head p { color: var(--sp-ink-mid); max-width: 540px; margin: 0 auto; }

  .sp-hiw__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 36px;
    position: relative;
  }
  @media (max-width: 720px) {
    .sp-hiw__grid { grid-template-columns: 1fr; gap: 28px; }
  }

  .sp-hiw__step {
    text-align: center;
    position: relative;
  }
  .sp-hiw__step:not(:last-child)::after {
    content: "";
    position: absolute;
    top: 60px;
    right: -22px;
    width: 44px;
    height: 1px;
    background: linear-gradient(to right, var(--sp-poppy), transparent);
    opacity: 0.4;
  }
  @media (max-width: 720px) { .sp-hiw__step::after { display: none !important; } }

  .sp-hiw__icon {
    width: 120px;
    height: 120px;
    margin: 0 auto 22px;
    background: var(--sp-blush-soft);
    border-radius: 999px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.3s ease;
  }
  .sp-hiw__step:hover .sp-hiw__icon { transform: translateY(-4px); }
  .sp-hiw__icon svg { width: 56px; height: 56px; stroke: var(--sp-poppy); fill: none; stroke-width: 1.5; stroke-linejoin: round; stroke-linecap: round; }

  .sp-hiw__num {
    font-family: 'IBM Plex Sans', sans-serif;
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--sp-poppy);
    margin-bottom: 8px;
    font-weight: 500;
  }
  .sp-hiw__step h3 {
    font-family: 'Fraunces', serif;
    font-size: 1.5rem;
    color: var(--sp-ink);
    text-transform: lowercase;
    margin-bottom: 12px;
    font-weight: 400;
    line-height: 1.15;
    font-variation-settings: "opsz" 96;
  }
  .sp-hiw__step p {
    font-family: 'IBM Plex Sans', sans-serif;
    font-size: 0.9375rem;
    color: var(--sp-ink-mid);
    line-height: 1.6;
    max-width: 280px;
    margin: 0 auto;
  }
</style>

{%- capture peel_icon -%}
  <svg viewBox="0 0 64 64" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <rect x="14" y="18" width="36" height="28" rx="4"/>
    <path d="M 14 22 C 22 12, 38 12, 50 22"/>
    <path d="M 22 30 L 42 30" opacity="0.4"/>
    <path d="M 22 36 L 38 36" opacity="0.4"/>
  </svg>
{%- endcapture -%}

{%- capture stick_icon -%}
  <svg viewBox="0 0 64 64" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <path d="M 14 38 C 14 22, 50 22, 50 38 C 50 48, 38 52, 32 52 C 26 52, 14 48, 14 38 Z"/>
    <circle cx="32" cy="32" r="8"/>
    <path d="M 32 26 L 32 18" stroke-dasharray="2 3"/>
  </svg>
{%- endcapture -%}

{%- capture support_icon -%}
  <svg viewBox="0 0 64 64" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <circle cx="32" cy="32" r="22"/>
    <path d="M 32 18 L 32 32 L 42 38"/>
    <path d="M 26 12 L 26 8" opacity="0.5"/>
    <path d="M 38 12 L 38 8" opacity="0.5"/>
  </svg>
{%- endcapture -%}

{%- capture sun_icon -%}
  <svg viewBox="0 0 64 64" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <circle cx="32" cy="32" r="10"/>
    <path d="M 32 14 L 32 8 M 32 56 L 32 50 M 14 32 L 8 32 M 56 32 L 50 32 M 19 19 L 14 14 M 50 50 L 45 45 M 19 45 L 14 50 M 50 14 L 45 19"/>
  </svg>
{%- endcapture -%}

{%- capture flower_icon -%}
  <svg viewBox="0 0 64 64" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <path d="M 32 12 C 38 18, 38 28, 32 32 C 26 28, 26 18, 32 12 Z"/>
    <path d="M 52 32 C 46 38, 36 38, 32 32 C 36 26, 46 26, 52 32 Z"/>
    <path d="M 32 52 C 26 46, 26 36, 32 32 C 38 36, 38 46, 32 52 Z"/>
    <path d="M 12 32 C 18 26, 28 26, 32 32 C 28 38, 18 38, 12 32 Z"/>
    <circle cx="32" cy="32" r="2"/>
  </svg>
{%- endcapture -%}

<section class="sp-hiw"
  style="--sp-pad-top: {{ section.settings.pad_top }}px; --sp-pad-bottom: {{ section.settings.pad_bottom }}px;">
  <div class="sp-wrap">
    <div class="sp-hiw__head">
      {%- if section.settings.kicker != blank -%}<span class="sp-kicker">{{ section.settings.kicker }}</span>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="sp-h2">{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.lede != blank -%}<p>{{ section.settings.lede }}</p>{%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="sp-hiw__grid">
        {%- for block in section.blocks -%}
          {%- if block.type == 'step' -%}
            <div class="sp-hiw__step" {{ block.shopify_attributes }}>
              <div class="sp-hiw__icon">
                {%- case block.settings.icon -%}
                  {%- when 'peel' -%}{{ peel_icon }}
                  {%- when 'stick' -%}{{ stick_icon }}
                  {%- when 'support' -%}{{ support_icon }}
                  {%- when 'sun' -%}{{ sun_icon }}
                  {%- when 'flower' -%}{{ flower_icon }}
                  {%- else -%}{{ peel_icon }}
                {%- endcase -%}
              </div>
              {%- if block.settings.num != blank -%}<div class="sp-hiw__num">{{ block.settings.num }}</div>{%- endif -%}
              {%- if block.settings.heading != blank -%}<h3>{{ block.settings.heading }}</h3>{%- endif -%}
              {%- if block.settings.body != blank -%}<p>{{ block.settings.body }}</p>{%- endif -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "How it works",
  "tag": "section",
  "class": "sp-how-it-works-section",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "how it works" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "three steps. one decision a day." },
    { "type": "richtext", "id": "lede", "label": "Lede", "default": "<p>peel, stick, forget about it. the only thing simpler than this routine is not having one.</p>" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "pad_top", "label": "Padding top", "min": 0, "max": 200, "step": 8, "unit": "px", "default": 96 },
    { "type": "range", "id": "pad_bottom", "label": "Padding bottom", "min": 0, "max": 200, "step": 8, "unit": "px", "default": 96 }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon",
          "options": [
            { "value": "peel", "label": "Peel" },
            { "value": "stick", "label": "Stick (placement)" },
            { "value": "support", "label": "Support (clock)" },
            { "value": "sun", "label": "Sun" },
            { "value": "flower", "label": "Flower (brand mark)" }
          ],
          "default": "peel"
        },
        { "type": "text", "id": "num", "label": "Number / eyebrow", "default": "step 01" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "peel" },
        { "type": "textarea", "id": "body", "label": "Body", "default": "peel one patch from the daily strip. takes about three seconds." }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "How it works",
      "blocks": [
        { "type": "step", "settings": { "icon": "peel", "num": "step 01", "heading": "peel", "body": "peel one patch from the daily strip. takes about three seconds. no water, no swallowing." } },
        { "type": "step", "settings": { "icon": "stick", "num": "step 02", "heading": "stick", "body": "place it on the inside of your forearm or shoulder. anywhere with thin, clean skin works. rotate placement daily." } },
        { "type": "step", "settings": { "icon": "support", "num": "step 03", "heading": "support, all day", "body": "the patch delivers organic triple-source maca through the skin for 24 hours. swap for a fresh one tomorrow morning." } }
      ]
    }
  ]
}
{% endschema %}
