{%- comment -%}
  SoftPauses video section. Accepts a YouTube/Vimeo URL via Shopify's
  video_url setting OR an uploaded MP4 via the video setting. Lazy-loads
  the embed (renders a poster thumbnail with a play button until clicked).
{%- endcomment -%}

<style>
  .sp-video { padding-top: var(--sp-pad-top, 96px); padding-bottom: var(--sp-pad-bottom, 96px); background: var(--sp-cream); }
  @media (max-width: 720px) { .sp-video { padding-top: 64px; padding-bottom: 64px; } }
  .sp-video__head { text-align: center; margin-bottom: 36px; }
  .sp-video__head h2 { margin-bottom: 14px; }
  .sp-video__head p { color: var(--sp-ink-mid); max-width: 540px; margin: 0 auto; }

  .sp-video__frame {
    aspect-ratio: 16 / 9;
    border-radius: 4px;
    overflow: hidden;
    background:
      radial-gradient(ellipse at 30% 40%, rgba(254, 117, 111, 0.3), transparent 60%),
      radial-gradient(ellipse at 80% 70%, rgba(254, 217, 209, 0.5), transparent 50%),
      var(--sp-cream-deep);
    position: relative;
    cursor: pointer;
    max-width: 920px;
    margin: 0 auto;
  }
  .sp-video__poster { width: 100%; height: 100%; object-fit: cover; display: block; }
  .sp-video__frame video, .sp-video__frame iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
  .sp-video__play {
    position: absolute;
    top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    width: 88px; height: 88px;
    background: var(--sp-cream);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 6px 24px rgba(42, 20, 16, 0.18);
    transition: transform 0.18s, box-shadow 0.18s;
  }
  .sp-video__frame:hover .sp-video__play {
    transform: translate(-50%, -50%) scale(1.06);
    box-shadow: 0 8px 32px rgba(42, 20, 16, 0.25);
  }
  .sp-video__play::after {
    content: "";
    width: 0; height: 0;
    border-left: 22px solid var(--sp-poppy);
    border-top: 14px solid transparent;
    border-bottom: 14px solid transparent;
    margin-left: 6px;
  }
  .sp-video__caption {
    text-align: center;
    margin-top: 18px;
    font-family: 'IBM Plex Sans', sans-serif;
    font-size: 13px;
    color: var(--sp-ink-muted);
    font-style: italic;
  }
</style>

{%- liquid
  assign embed_url = ''
  if section.settings.video_url != blank
    assign url_str = section.settings.video_url | replace: 'https://', '' | replace: 'http://', ''
    if url_str contains 'youtube.com/watch?v=' or url_str contains 'youtu.be/'
      assign id = section.settings.video_url | split: 'v=' | last | split: '&' | first | split: '/' | last | split: '?' | first
      assign embed_url = 'https://www.youtube.com/embed/' | append: id | append: '?autoplay=1&rel=0'
    elsif url_str contains 'vimeo.com'
      assign id = section.settings.video_url | split: '/' | last | split: '?' | first
      assign embed_url = 'https://player.vimeo.com/video/' | append: id | append: '?autoplay=1'
    endif
  endif
-%}

<section class="sp-video"
  style="--sp-pad-top: {{ section.settings.pad_top }}px; --sp-pad-bottom: {{ section.settings.pad_bottom }}px;">
  <div class="sp-wrap">
    <div class="sp-video__head">
      {%- if section.settings.kicker != blank -%}<span class="sp-kicker">{{ section.settings.kicker }}</span>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="sp-h2">{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.lede != blank -%}<p>{{ section.settings.lede }}</p>{%- endif -%}
    </div>

    <div class="sp-video__frame" data-sp-video data-embed="{{ embed_url | escape }}">
      {%- if section.settings.poster != blank -%}
        {{ section.settings.poster | image_url: width: 1600 | image_tag:
          class: 'sp-video__poster',
          loading: 'lazy',
          sizes: '(min-width: 920px) 920px, 100vw',
          widths: '720, 1080, 1440, 1920',
          alt: section.settings.heading | default: 'Video poster'
        }}
      {%- endif -%}
      <button type="button" class="sp-video__play" aria-label="Play video"></button>
    </div>

    {%- if section.settings.caption != blank -%}
      <p class="sp-video__caption">{{ section.settings.caption }}</p>
    {%- endif -%}
  </div>
</section>

<script>
  (function() {
    const root = document.querySelector('#shopify-section-{{ section.id }} [data-sp-video]');
    if (!root) return;
    const embed = root.getAttribute('data-embed');
    if (!embed) return;
    root.addEventListener('click', function() {
      if (root.dataset.played) return;
      root.dataset.played = '1';
      const iframe = document.createElement('iframe');
      iframe.src = embed;
      iframe.setAttribute('allow', 'autoplay; encrypted-media; picture-in-picture');
      iframe.setAttribute('allowfullscreen', '');
      iframe.setAttribute('loading', 'lazy');
      root.innerHTML = '';
      root.appendChild(iframe);
    });
  })();
</script>

{% schema %}
{
  "name": "Video",
  "tag": "section",
  "class": "sp-video-section",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "see soft pauses in 60 seconds." },
    { "type": "richtext", "id": "lede", "label": "Lede", "default": "<p>the patch, the routine, the women using it.</p>" },
    { "type": "header", "content": "Video" },
    { "type": "video_url", "id": "video_url", "label": "YouTube or Vimeo URL", "accept": ["youtube", "vimeo"] },
    { "type": "image_picker", "id": "poster", "label": "Poster image (16:9, ~1600x900)" },
    { "type": "text", "id": "caption", "label": "Caption" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "pad_top", "label": "Padding top", "min": 0, "max": 200, "step": 8, "unit": "px", "default": 96 },
    { "type": "range", "id": "pad_bottom", "label": "Padding bottom", "min": 0, "max": 200, "step": 8, "unit": "px", "default": 96 }
  ],
  "presets": [
    { "name": "Video" }
  ]
}
{% endschema %}
