{%- comment -%}
  SoftPauses pain agitation. Each pain point is a block: customer-facing
  dismissive quote + the brand's reframe. Optional stat callout below.
{%- endcomment -%}

<style>
  #shopify-section-{{ section.id }} { background: var(--sp-blush-soft); }
  .sp-pain { padding-top: var(--sp-pad-top, 96px); padding-bottom: var(--sp-pad-bottom, 96px); }
  @media (max-width: 720px) { .sp-pain { padding-top: 64px; padding-bottom: 64px; } }
  .sp-pain__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
    margin-top: 36px;
  }
  @media (max-width: 720px) { .sp-pain__grid { grid-template-columns: 1fr; } }
  .sp-pain__card {
    background: var(--sp-cream);
    padding: 28px 22px;
    border-radius: 4px;
    border-left: 2px solid var(--sp-poppy);
  }
  .sp-pain__q {
    font-family: 'Fraunces', serif;
    font-style: italic;
    font-size: 1.0625rem;
    line-height: 1.45;
    color: var(--sp-ink-muted);
    margin-bottom: 10px;
    font-variation-settings: "opsz" 72;
  }
  .sp-pain__a {
    font-family: 'Fraunces', serif;
    font-size: 1.25rem;
    line-height: 1.3;
    color: var(--sp-ink);
    text-transform: lowercase;
    font-variation-settings: "opsz" 96;
  }
  .sp-pain__stat {
    margin-top: 36px;
    padding: 28px 32px;
    background: var(--sp-cream);
    border-radius: 4px;
    text-align: center;
  }
  .sp-pain__stat .big {
    font-family: 'Fraunces', serif;
    font-size: clamp(2.5rem, 6vw, 3.75rem);
    color: var(--sp-poppy);
    line-height: 1;
    font-variation-settings: "opsz" 144;
    margin-bottom: 8px;
  }
  .sp-pain__stat p {
    color: var(--sp-ink-mid);
    font-size: 0.95rem;
    max-width: 540px;
    margin: 0 auto;
  }
</style>

<section class="sp-pain"
  style="--sp-pad-top: {{ section.settings.pad_top }}px; --sp-pad-bottom: {{ section.settings.pad_bottom }}px;">
  <div class="sp-wrap sp-wrap--mid">
    {%- if section.settings.chapter_label != blank or section.settings.chapter_num != blank -%}
      <div class="sp-chapter">
        <span class="sp-chapter__label">{{ section.settings.chapter_label }}</span>
        <span class="sp-chapter__num">{{ section.settings.chapter_num }}</span>
      </div>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}<h2 class="sp-h2">{{ section.settings.heading }}</h2>{%- endif -%}
    {%- if section.settings.lede != blank -%}<div class="sp-lede">{{ section.settings.lede }}</div>{%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="sp-pain__grid">
        {%- for block in section.blocks -%}
          {%- if block.type == 'pain' -%}
            <div class="sp-pain__card" {{ block.shopify_attributes }}>
              <div class="sp-pain__q">&ldquo;{{ block.settings.quote }}&rdquo;</div>
              <div class="sp-pain__a">{{ block.settings.reframe }}</div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if section.settings.stat_big != blank or section.settings.stat_text != blank -%}
      <div class="sp-pain__stat">
        {%- if section.settings.stat_big != blank -%}<div class="big">{{ section.settings.stat_big }}</div>{%- endif -%}
        {%- if section.settings.stat_text != blank -%}<p>{{ section.settings.stat_text }}</p>{%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Pain agitation",
  "tag": "section",
  "class": "sp-pain-section",
  "settings": [
    { "type": "text", "id": "chapter_label", "label": "Chapter label", "default": "the wake-up call" },
    { "type": "text", "id": "chapter_num", "label": "Chapter number", "default": "/ 01" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "if you've heard any of this, this is for you." },
    { "type": "richtext", "id": "lede", "label": "Lede", "default": "<p>you already knew something was wrong. you were right.</p>" },
    { "type": "header", "content": "Stat callout" },
    { "type": "text", "id": "stat_big", "label": "Big number", "default": "1 in 3" },
    { "type": "textarea", "id": "stat_text", "label": "Stat description", "default": "women in perimenopause are dismissed by their doctor on the first visit. perimenopause can start in your late 30s and last up to a decade. the medical system is a generation behind on this. you don't have a generation." },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "pad_top", "label": "Padding top", "min": 0, "max": 200, "step": 8, "unit": "px", "default": 96 },
    { "type": "range", "id": "pad_bottom", "label": "Padding bottom", "min": 0, "max": 200, "step": 8, "unit": "px", "default": 96 }
  ],
  "blocks": [
    {
      "type": "pain",
      "name": "Pain point",
      "settings": [
        { "type": "text", "id": "quote", "label": "Dismissive quote (what they hear)", "default": "it's just stress." },
        { "type": "text", "id": "reframe", "label": "Reframe (the truth)", "default": "it isn't just stress." }
      ]
    }
  ],
  "max_blocks": 9,
  "presets": [
    {
      "name": "Pain agitation",
      "blocks": [
        { "type": "pain", "settings": { "quote": "it's just stress.", "reframe": "it isn't just stress." } },
        { "type": "pain", "settings": { "quote": "your labs are normal.", "reframe": "labs miss perimenopause." } },
        { "type": "pain", "settings": { "quote": "you're too young for that.", "reframe": "it can start at 38." } },
        { "type": "pain", "settings": { "quote": "have you tried yoga.", "reframe": "yoga is not a hormone." } },
        { "type": "pain", "settings": { "quote": "maybe try an antidepressant.", "reframe": "it's not depression." } },
        { "type": "pain", "settings": { "quote": "it's just part of getting older.", "reframe": "it doesn't have to be." } }
      ]
    }
  ]
}
{% endschema %}
