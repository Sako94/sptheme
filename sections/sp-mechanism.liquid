{%- comment -%}
  SoftPauses mechanism section. Left: SVG bio chart (estrogen erratic curve).
  Right: editable mechanism cards as blocks.
{%- endcomment -%}

<style>
  #shopify-section-{{ section.id }} { background: var(--sp-cream); }
  .sp-mech { padding-top: var(--sp-pad-top, 96px); padding-bottom: var(--sp-pad-bottom, 96px); }
  @media (max-width: 720px) { .sp-mech { padding-top: 64px; padding-bottom: 64px; } }
  .sp-mech__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 56px;
    align-items: center;
    margin-top: 30px;
  }
  @media (max-width: 900px) { .sp-mech__grid { grid-template-columns: 1fr; gap: 32px; } }
  .sp-mech__bio {
    aspect-ratio: 1 / 1;
    background: var(--sp-blush-soft);
    border-radius: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    position: relative;
  }
  .sp-mech__bio svg { width: 70%; max-width: 320px; }
  .sp-mech__bio img {
    width: 100%; height: 100%; object-fit: cover;
  }
  .sp-mech__cards { display: grid; gap: 16px; }
  .sp-mech__card {
    background: var(--sp-cream);
    padding: 24px 26px;
    border-radius: 4px;
    border: 1px solid var(--sp-rule);
  }
  .sp-mech__card .label {
    font-family: 'IBM Plex Sans', sans-serif;
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--sp-poppy);
    margin-bottom: 8px;
    font-weight: 500;
  }
  .sp-mech__card h4 {
    font-family: 'Fraunces', serif;
    font-size: 1.25rem;
    margin-bottom: 8px;
    text-transform: lowercase;
    color: var(--sp-ink);
    font-weight: 400;
    font-variation-settings: "opsz" 96;
  }
  .sp-mech__card p {
    font-size: 0.95rem;
    color: var(--sp-ink-mid);
    line-height: 1.55;
    margin: 0;
  }
</style>

<section class="sp-mech"
  style="--sp-pad-top: {{ section.settings.pad_top }}px; --sp-pad-bottom: {{ section.settings.pad_bottom }}px;">
  <div class="sp-wrap sp-wrap--mid">
    {%- if section.settings.chapter_label != blank or section.settings.chapter_num != blank -%}
      <div class="sp-chapter">
        <span class="sp-chapter__label">{{ section.settings.chapter_label }}</span>
        <span class="sp-chapter__num">{{ section.settings.chapter_num }}</span>
      </div>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}<h2 class="sp-h2">{{ section.settings.heading }}</h2>{%- endif -%}
    {%- if section.settings.lede != blank -%}<div class="sp-lede">{{ section.settings.lede }}</div>{%- endif -%}

    <div class="sp-mech__grid">
      <div class="sp-mech__bio" role="img" aria-label="{{ section.settings.bio_alt | default: 'Hormone fluctuation diagram' }}">
        {%- if section.settings.bio_image != blank -%}
          {{ section.settings.bio_image | image_url: width: 800 | image_tag:
            loading: 'lazy',
            sizes: '(min-width: 900px) 440px, 100vw',
            widths: '440, 880',
            alt: section.settings.bio_alt | default: 'Hormone fluctuation diagram'
          }}
        {%- else -%}
          <svg viewBox="0 0 320 320" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <defs>
              <linearGradient id="spBioGrad-{{ section.id }}" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0%" stop-color="#FE756F" stop-opacity="0.85"/>
                <stop offset="100%" stop-color="#ED1B28" stop-opacity="0.95"/>
              </linearGradient>
            </defs>
            <line x1="20" y1="240" x2="300" y2="240" stroke="#E8D5C5" stroke-width="1"/>
            <line x1="20" y1="180" x2="300" y2="180" stroke="#E8D5C5" stroke-width="1" stroke-dasharray="3 4"/>
            <line x1="20" y1="120" x2="300" y2="120" stroke="#E8D5C5" stroke-width="1" stroke-dasharray="3 4"/>
            <path d="M 20 180 Q 50 80, 80 130 T 140 90 Q 170 200, 200 110 T 260 230 Q 280 130, 300 200" fill="none" stroke="url(#spBioGrad-{{ section.id }})" stroke-width="3" stroke-linecap="round"/>
            <path d="M 20 200 Q 100 195, 160 198 T 300 220" fill="none" stroke="#8A6E64" stroke-width="1.5" stroke-dasharray="4 5" opacity="0.5"/>
            <text x="20" y="270" font-family="IBM Plex Sans, sans-serif" font-size="11" fill="#8A6E64" letter-spacing="2">{{ section.settings.bio_label_now | default: 'YOUR ESTROGEN, NOW' }}</text>
            <text x="20" y="290" font-family="IBM Plex Sans, sans-serif" font-size="11" fill="#8A6E64" letter-spacing="2" opacity="0.7">{{ section.settings.bio_label_before | default: 'YOUR ESTROGEN, BEFORE 38' }}</text>
          </svg>
        {%- endif -%}
      </div>

      <div class="sp-mech__cards">
        {%- for block in section.blocks -%}
          {%- if block.type == 'card' -%}
            <div class="sp-mech__card" {{ block.shopify_attributes }}>
              {%- if block.settings.label != blank -%}<div class="label">{{ block.settings.label }}</div>{%- endif -%}
              {%- if block.settings.heading != blank -%}<h4>{{ block.settings.heading }}</h4>{%- endif -%}
              {%- if block.settings.body != blank -%}<p>{{ block.settings.body }}</p>{%- endif -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Mechanism",
  "tag": "section",
  "class": "sp-mechanism-section",
  "settings": [
    { "type": "text", "id": "chapter_label", "label": "Chapter label", "default": "the biology" },
    { "type": "text", "id": "chapter_num", "label": "Chapter number", "default": "/ 02" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "what's actually happening." },
    { "type": "richtext", "id": "lede", "label": "Lede", "default": "<p>perimenopause is the years of hormonal turbulence before your last period. estrogen and progesterone don't taper smoothly. they swing.</p>" },
    { "type": "header", "content": "Bio diagram" },
    { "type": "image_picker", "id": "bio_image", "label": "Diagram image (optional, replaces SVG)" },
    { "type": "text", "id": "bio_alt", "label": "Image alt text", "default": "Hormone fluctuation diagram" },
    { "type": "text", "id": "bio_label_now", "label": "SVG label — 'now'", "default": "YOUR ESTROGEN, NOW" },
    { "type": "text", "id": "bio_label_before", "label": "SVG label — 'before'", "default": "YOUR ESTROGEN, BEFORE 38" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "pad_top", "label": "Padding top", "min": 0, "max": 200, "step": 8, "unit": "px", "default": 96 },
    { "type": "range", "id": "pad_bottom", "label": "Padding bottom", "min": 0, "max": 200, "step": 8, "unit": "px", "default": 96 }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Mechanism card",
      "settings": [
        { "type": "text", "id": "label", "label": "Eyebrow label", "default": "the problem" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "hormones swing, not taper." },
        { "type": "textarea", "id": "body", "label": "Body", "default": "estrogen drops, spikes, drops again. your sleep, energy, mood, and focus follow." }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Mechanism",
      "blocks": [
        { "type": "card", "settings": { "label": "the problem", "heading": "hormones swing, not taper.", "body": "estrogen drops, spikes, drops again. your sleep, energy, mood, and focus follow. this is not a deficiency you fix once. it's a transition you support, daily." } },
        { "type": "card", "settings": { "label": "why a patch", "heading": "once a day, on the skin, done.", "body": "pills require a digestive system that is also doing its own thing right now. they require remembering. a patch delivers organic maca through the skin for 24 hours. peel, stick, forget about it." } },
        { "type": "card", "settings": { "label": "why maca", "heading": "used for centuries. studied for decades.", "body": "women in the andes have used maca to support energy and mood through major hormonal transitions for over 2,000 years. modern research backs the same use." } }
      ]
    }
  ]
}
{% endschema %}
