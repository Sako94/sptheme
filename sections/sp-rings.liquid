{%- comment -%}
  SoftPauses before/after rings. Three SVG ring charts (default: mood,
  sleep, energy) showing self-reported scores before vs after 30 days.
  Each ring is a block with 'before' and 'after' percentages.
{%- endcomment -%}

<style>
  #shopify-section-{{ section.id }} { background: var(--sp-blush-soft); }
  .sp-rings { padding-top: var(--sp-pad-top, 96px); padding-bottom: var(--sp-pad-bottom, 96px); }
  @media (max-width: 720px) { .sp-rings { padding-top: 64px; padding-bottom: 64px; } }
  .sp-rings__head { text-align: center; margin-bottom: 36px; }
  .sp-rings__head h2 { margin-bottom: 14px; }
  .sp-rings__head p { color: var(--sp-ink-mid); max-width: 560px; margin: 0 auto; }

  .sp-rings__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
  @media (max-width: 720px) { .sp-rings__grid { grid-template-columns: 1fr; } }

  .sp-rings__card {
    background: var(--sp-cream);
    border-radius: 4px;
    padding: 28px 24px;
    text-align: center;
  }
  .sp-rings__svg { width: 100%; max-width: 200px; height: auto; margin: 0 auto; display: block; }

  .sp-rings__label {
    font-family: 'Fraunces', serif;
    font-size: 1.25rem;
    color: var(--sp-ink);
    text-transform: lowercase;
    margin-top: 16px;
    margin-bottom: 4px;
    font-weight: 500;
    font-variation-settings: "opsz" 96;
  }
  .sp-rings__delta {
    font-family: 'IBM Plex Sans', sans-serif;
    font-size: 12px;
    color: var(--sp-poppy);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-weight: 500;
    margin-bottom: 14px;
  }
  .sp-rings__compare {
    display: flex;
    justify-content: center;
    gap: 24px;
    font-family: 'IBM Plex Sans', sans-serif;
    font-size: 11px;
    color: var(--sp-ink-mid);
  }
  .sp-rings__compare strong {
    display: block;
    font-family: 'Fraunces', serif;
    font-size: 1.0625rem;
    color: var(--sp-ink);
    margin-top: 2px;
    font-variation-settings: "opsz" 72;
    font-weight: 500;
  }
  .sp-rings__compare .after strong { color: var(--sp-poppy); }

  .sp-rings__foot {
    text-align: center;
    margin-top: 22px;
    font-family: 'IBM Plex Sans', sans-serif;
    font-size: 12px;
    color: var(--sp-ink-muted);
    font-style: italic;
  }
</style>

<section class="sp-rings"
  style="--sp-pad-top: {{ section.settings.pad_top }}px; --sp-pad-bottom: {{ section.settings.pad_bottom }}px;">
  <div class="sp-wrap">
    <div class="sp-rings__head">
      {%- if section.settings.kicker != blank -%}<span class="sp-kicker">{{ section.settings.kicker }}</span>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="sp-h2">{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.lede != blank -%}<p>{{ section.settings.lede }}</p>{%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="sp-rings__grid">
        {%- for block in section.blocks -%}
          {%- if block.type == 'ring' -%}
            {%- assign before = block.settings.before | default: 30 -%}
            {%- assign after = block.settings.after | default: 80 -%}
            {%- assign before_offset = 339.292 | minus: 339.292 | times: before | divided_by: 100.0 -%}
            {%- assign after_offset = 339.292 | minus: 339.292 | times: after | divided_by: 100.0 -%}
            {%- assign before_dasharray = 339.292 | times: before | divided_by: 100.0 -%}
            {%- assign after_dasharray = 339.292 | times: after | divided_by: 100.0 -%}
            <div class="sp-rings__card" {{ block.shopify_attributes }}>
              <svg class="sp-rings__svg" viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg" aria-label="{{ block.settings.label }} before {{ before }} percent, after {{ after }} percent">
                <!-- Background track -->
                <circle cx="100" cy="100" r="54" fill="none" stroke="#FED9D1" stroke-width="14" opacity="0.6"/>
                <!-- Before ring (muted) -->
                <circle cx="100" cy="100" r="72" fill="none" stroke="#E8D5C5" stroke-width="6"/>
                <circle cx="100" cy="100" r="72" fill="none" stroke="#8A6E64" stroke-width="6" stroke-linecap="round"
                        stroke-dasharray="{{ before_dasharray }} 1000" stroke-dashoffset="0"
                        transform="rotate(-90 100 100)" opacity="0.55"/>
                <!-- After ring (poppy) -->
                <circle cx="100" cy="100" r="54" fill="none" stroke="#ED1B28" stroke-width="14" stroke-linecap="round"
                        stroke-dasharray="{{ after_dasharray }} 1000" stroke-dashoffset="0"
                        transform="rotate(-90 100 100)"/>
                <!-- Center value (after %) -->
                <text x="100" y="98" text-anchor="middle" font-family="Fraunces, serif" font-size="36" fill="#ED1B28" font-variation-settings="'opsz' 144" font-weight="500">{{ after }}</text>
                <text x="100" y="118" text-anchor="middle" font-family="IBM Plex Sans, sans-serif" font-size="10" letter-spacing="2" fill="#8A6E64">SCORE / 100</text>
              </svg>

              <div class="sp-rings__label">{{ block.settings.label }}</div>
              {%- assign delta = after | minus: before -%}
              <div class="sp-rings__delta">
                {%- if delta > 0 -%}+{{ delta }} points{%- else -%}{{ delta }} points{%- endif -%}
              </div>
              <div class="sp-rings__compare">
                <div class="before">before<strong>{{ before }}</strong></div>
                <div class="after">day 30<strong>{{ after }}</strong></div>
              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if section.settings.foot != blank -%}<p class="sp-rings__foot">{{ section.settings.foot }}</p>{%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Before/after rings",
  "tag": "section",
  "class": "sp-rings-section",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "before vs after 30 days" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "the shape of a 30-day reset." },
    { "type": "richtext", "id": "lede", "label": "Lede", "default": "<p>self-reported scores at day 0 (before starting) and day 30 (after consistent daily use). same questions, same women, 30 days apart.</p>" },
    { "type": "text", "id": "foot", "label": "Footnote", "default": "Scores from a self-reported post-purchase survey of 500 daily users. Higher = better. Not a placebo-controlled clinical measurement." },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "pad_top", "label": "Padding top", "min": 0, "max": 200, "step": 8, "unit": "px", "default": 96 },
    { "type": "range", "id": "pad_bottom", "label": "Padding bottom", "min": 0, "max": 200, "step": 8, "unit": "px", "default": 96 }
  ],
  "blocks": [
    {
      "type": "ring",
      "name": "Ring chart",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "mood" },
        { "type": "range", "id": "before", "label": "Before score (0-100)", "min": 0, "max": 100, "step": 1, "default": 35 },
        { "type": "range", "id": "after", "label": "After score (0-100)", "min": 0, "max": 100, "step": 1, "default": 78 }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Before/after rings",
      "blocks": [
        { "type": "ring", "settings": { "label": "mood", "before": 35, "after": 78 } },
        { "type": "ring", "settings": { "label": "sleep", "before": 42, "after": 81 } },
        { "type": "ring", "settings": { "label": "energy", "before": 38, "after": 84 } }
      ]
    }
  ]
}
{% endschema %}
