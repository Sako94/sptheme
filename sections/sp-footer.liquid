{%- comment -%}
  SoftPauses footer. Ink background, brand wordmark left, navigation
  columns. Each column is a block with a heading + a Shopify menu reference.
{%- endcomment -%}

<style>
  #shopify-section-{{ section.id }} { background: var(--sp-ink); color: rgba(250, 241, 234, 0.7); }
  .sp-footer { padding-top: var(--sp-pad-top, 60px); padding-bottom: 32px; }
  @media (max-width: 720px) { .sp-footer { padding-top: 48px; } }
  .sp-footer__row {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1fr;
    gap: 40px;
    margin-bottom: 48px;
  }
  @media (max-width: 720px) {
    .sp-footer__row { grid-template-columns: 1fr 1fr; gap: 32px; }
  }
  .sp-footer__brand .sp-wordmark {
    color: var(--sp-cream);
    font-size: 32px;
    margin-bottom: 14px;
  }
  .sp-footer__tagline {
    font-family: 'IBM Plex Sans', sans-serif;
    font-size: 11px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(250, 241, 234, 0.6);
    margin-bottom: 18px;
  }
  .sp-footer__brand p {
    font-family: 'IBM Plex Sans', sans-serif;
    font-size: 13px;
    color: rgba(250, 241, 234, 0.7);
    line-height: 1.6;
    max-width: 280px;
  }

  .sp-footer__col h5 {
    font-family: 'IBM Plex Sans', sans-serif;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--sp-cream);
    margin-bottom: 16px;
  }
  .sp-footer__col ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .sp-footer__col li { margin-bottom: 8px; }
  .sp-footer__col a {
    font-family: 'IBM Plex Sans', sans-serif;
    color: rgba(250, 241, 234, 0.65);
    text-decoration: none;
    font-size: 13.5px;
    transition: color 0.18s;
    text-transform: lowercase;
  }
  .sp-footer__col a:hover { color: var(--sp-coral); }

  .sp-footer__bottom {
    border-top: 1px solid rgba(250, 241, 234, 0.12);
    padding-top: 24px;
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 14px;
    font-family: 'IBM Plex Sans', sans-serif;
    font-size: 11.5px;
    color: rgba(250, 241, 234, 0.5);
  }
  .sp-footer__bottom a {
    color: rgba(250, 241, 234, 0.5);
    text-decoration: none;
  }
  .sp-footer__bottom a:hover { color: var(--sp-coral); }

  .sp-footer__disclaimer {
    margin-top: 24px;
    font-family: 'IBM Plex Sans', sans-serif;
    font-size: 10.5px;
    color: rgba(250, 241, 234, 0.4);
    line-height: 1.6;
    max-width: 720px;
  }
</style>

<footer class="sp-footer"
  style="--sp-pad-top: {{ section.settings.pad_top }}px;">
  <div class="sp-wrap">
    <div class="sp-footer__row">
      <div class="sp-footer__brand">
        <a href="{{ routes.root_url }}" class="sp-wordmark">{{ section.settings.wordmark | default: shop.name }}</a>
        {%- if section.settings.tagline != blank -%}<div class="sp-footer__tagline">{{ section.settings.tagline }}</div>{%- endif -%}
        {%- if section.settings.description != blank -%}<p>{{ section.settings.description }}</p>{%- endif -%}
      </div>

      {%- for block in section.blocks -%}
        {%- if block.type == 'menu_column' -%}
          <div class="sp-footer__col" {{ block.shopify_attributes }}>
            {%- if block.settings.heading != blank -%}<h5>{{ block.settings.heading }}</h5>{%- endif -%}
            {%- if block.settings.menu != blank -%}
              <ul>
                {%- for link in block.settings.menu.links -%}
                  <li><a href="{{ link.url }}">{{ link.title | downcase }}</a></li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    <div class="sp-footer__bottom">
      <span>{{ section.settings.copyright | default: '(c) 2026 soft pauses, inc.' }}</span>
      {%- if section.settings.legal_text != blank -%}
        <span>{{ section.settings.legal_text }}</span>
      {%- endif -%}
    </div>

    {%- if section.settings.disclaimer != blank -%}
      <p class="sp-footer__disclaimer">{{ section.settings.disclaimer }}</p>
    {%- endif -%}
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "tag": "section",
  "class": "sp-footer-section",
  "settings": [
    { "type": "text", "id": "wordmark", "label": "Wordmark text", "default": "SoftPauses" },
    { "type": "text", "id": "tagline", "label": "Tagline (small caps)", "default": "pause. breathe. bloom." },
    { "type": "richtext", "id": "description", "label": "Description", "default": "<p>a daily transdermal patch with organic triple-source maca, designed for women in perimenopause. made with women, for women, in the US.</p>" },
    { "type": "header", "content": "Bottom row" },
    { "type": "text", "id": "copyright", "label": "Copyright", "default": "(c) 2026 soft pauses, inc." },
    { "type": "text", "id": "legal_text", "label": "Legal links text", "default": "terms | privacy | accessibility" },
    { "type": "header", "content": "Disclaimer" },
    { "type": "textarea", "id": "disclaimer", "label": "Disclaimer", "default": "soft pauses is a dietary supplement. these statements have not been evaluated by the FDA. this product is not intended to diagnose, treat, cure, or prevent any disease. consult your physician before starting any supplement, especially if you are pregnant, nursing, or taking medication." },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "pad_top", "label": "Padding top", "min": 0, "max": 200, "step": 8, "unit": "px", "default": 64 }
  ],
  "blocks": [
    {
      "type": "menu_column",
      "name": "Menu column",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "shop" },
        { "type": "link_list", "id": "menu", "label": "Menu", "info": "Pick a menu from Online Store -> Navigation" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Footer",
      "blocks": [
        { "type": "menu_column", "settings": { "heading": "shop" } },
        { "type": "menu_column", "settings": { "heading": "learn" } },
        { "type": "menu_column", "settings": { "heading": "support" } }
      ]
    }
  ]
}
{% endschema %}
