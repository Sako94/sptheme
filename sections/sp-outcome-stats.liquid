{%- comment -%}
  SoftPauses outcome stats. Editorial three-up of customer-reported numbers.
  Each card is a block with a big number + a short label.
{%- endcomment -%}

<style>
  #shopify-section-{{ section.id }} { background: var(--sp-blush-soft); }
  .sp-stats { padding-top: var(--sp-pad-top, 96px); padding-bottom: var(--sp-pad-bottom, 96px); }
  @media (max-width: 720px) { .sp-stats { padding-top: 64px; padding-bottom: 64px; } }
  .sp-stats__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
    margin-top: 36px;
  }
  @media (max-width: 720px) { .sp-stats__grid { grid-template-columns: 1fr; } }
  .sp-stats__card {
    background: var(--sp-blush);
    padding: 36px 28px;
    border-radius: 4px;
    text-align: center;
  }
  .sp-stats__card .big {
    font-family: 'Fraunces', serif;
    font-size: clamp(3rem, 7vw, 4.5rem);
    line-height: 1;
    color: var(--sp-poppy);
    font-variation-settings: "opsz" 144;
    margin-bottom: 10px;
    font-weight: 400;
  }
  .sp-stats__card .label {
    font-family: 'IBM Plex Sans', sans-serif;
    font-size: 14px;
    color: var(--sp-ink);
    line-height: 1.4;
  }
  .sp-stats__foot {
    margin-top: 18px;
    font-size: 11.5px;
    color: var(--sp-ink-muted);
    text-align: center;
    font-style: italic;
  }
</style>

<section class="sp-stats"
  style="--sp-pad-top: {{ section.settings.pad_top }}px; --sp-pad-bottom: {{ section.settings.pad_bottom }}px;">
  <div class="sp-wrap sp-wrap--mid">
    {%- if section.settings.chapter_label != blank or section.settings.chapter_num != blank -%}
      <div class="sp-chapter">
        <span class="sp-chapter__label">{{ section.settings.chapter_label }}</span>
        <span class="sp-chapter__num">{{ section.settings.chapter_num }}</span>
      </div>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}<h2 class="sp-h2">{{ section.settings.heading }}</h2>{%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="sp-stats__grid">
        {%- for block in section.blocks -%}
          {%- if block.type == 'stat' -%}
            <div class="sp-stats__card" {{ block.shopify_attributes }}>
              <div class="big">{{ block.settings.number }}</div>
              <div class="label">{{ block.settings.label }}</div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if section.settings.foot != blank -%}<p class="sp-stats__foot">{{ section.settings.foot }}</p>{%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Outcome stats",
  "tag": "section",
  "class": "sp-outcome-stats-section",
  "settings": [
    { "type": "text", "id": "chapter_label", "label": "Chapter label", "default": "what they say" },
    { "type": "text", "id": "chapter_num", "label": "Chapter number", "default": "/ 05" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "real users. real results." },
    { "type": "text", "id": "foot", "label": "Footnote", "default": "*post-purchase survey, 500 women, 30+ days of daily use." },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "pad_top", "label": "Padding top", "min": 0, "max": 200, "step": 8, "unit": "px", "default": 96 },
    { "type": "range", "id": "pad_bottom", "label": "Padding bottom", "min": 0, "max": 200, "step": 8, "unit": "px", "default": 96 }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        { "type": "text", "id": "number", "label": "Big number", "default": "87%" },
        { "type": "textarea", "id": "label", "label": "Label", "default": "say they have steadier energy through the day" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Outcome stats",
      "blocks": [
        { "type": "stat", "settings": { "number": "87%", "label": "say they have steadier energy through the day" } },
        { "type": "stat", "settings": { "number": "79%", "label": "say they sleep through the night more often" } },
        { "type": "stat", "settings": { "number": "91%", "label": "would recommend it to a friend in perimenopause" } }
      ]
    }
  ]
}
{% endschema %}
