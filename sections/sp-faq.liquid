{%- comment -%}
  SoftPauses FAQ section. Two block types:
    - tab:  defines a tab. Tab settings: id (slug), label.
    - item: an FAQ Q+A. Settings: tab (slug), question, answer.
  Items are matched to tabs by slug. Tabs without items still render.
{%- endcomment -%}

<style>
  #shopify-section-{{ section.id }} { background: var(--sp-blush-soft); }
  .sp-faq { padding-top: var(--sp-pad-top, 96px); padding-bottom: var(--sp-pad-bottom, 96px); }
  @media (max-width: 720px) { .sp-faq { padding-top: 64px; padding-bottom: 64px; } }
  .sp-faq__tabs {
    display: flex;
    gap: 8px;
    margin: 28px 0 22px;
    flex-wrap: wrap;
    justify-content: center;
  }
  .sp-faq__tab {
    background: transparent;
    border: 1px solid var(--sp-rule);
    padding: 8px 18px;
    border-radius: 999px;
    cursor: pointer;
    font-family: 'IBM Plex Sans', sans-serif;
    font-size: 13px;
    color: var(--sp-ink-mid);
    transition: all 0.18s;
    text-transform: lowercase;
  }
  .sp-faq__tab:hover { border-color: var(--sp-poppy); color: var(--sp-poppy); }
  .sp-faq__tab.is-active {
    background: var(--sp-poppy);
    border-color: var(--sp-poppy);
    color: var(--sp-cream);
  }

  .sp-faq__panel { display: none; }
  .sp-faq__panel.is-active { display: block; }

  .sp-faq__item {
    background: var(--sp-cream);
    margin-bottom: 8px;
    border-radius: 4px;
    overflow: hidden;
  }
  .sp-faq__item summary {
    padding: 22px 28px;
    cursor: pointer;
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 16px;
    font-family: 'Fraunces', serif;
    font-size: 1.125rem;
    color: var(--sp-ink);
    line-height: 1.35;
    text-transform: lowercase;
    font-weight: 500;
    font-variation-settings: "opsz" 72;
  }
  .sp-faq__item summary::-webkit-details-marker { display: none; }
  .sp-faq__item summary::after {
    content: "+";
    font-family: 'IBM Plex Sans', sans-serif;
    font-size: 1.5rem;
    color: var(--sp-poppy);
    font-weight: 300;
    line-height: 1;
    flex-shrink: 0;
    margin-top: 2px;
  }
  .sp-faq__item[open] summary::after { content: "−"; }
  .sp-faq__item .sp-faq__answer {
    padding: 0 28px 24px;
    color: var(--sp-ink-mid);
    font-size: 0.9375rem;
    line-height: 1.65;
    font-family: 'IBM Plex Sans', sans-serif;
  }
</style>

<section class="sp-faq"
  style="--sp-pad-top: {{ section.settings.pad_top }}px; --sp-pad-bottom: {{ section.settings.pad_bottom }}px;">
  <div class="sp-wrap sp-wrap--mid">
    {%- if section.settings.heading != blank -%}
      <h2 class="sp-h2" style="text-align: center;">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- assign tab_blocks = section.blocks | where: 'type', 'tab' -%}
    {%- assign item_blocks = section.blocks | where: 'type', 'item' -%}

    {%- if tab_blocks.size > 1 -%}
      <div class="sp-faq__tabs" role="tablist" data-sp-faq>
        {%- for tab in tab_blocks -%}
          <button
            type="button"
            class="sp-faq__tab{% if forloop.first %} is-active{% endif %}"
            data-tab="{{ tab.settings.tab_id | escape }}"
            role="tab"
            aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
          >{{ tab.settings.label }}</button>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- for tab in tab_blocks -%}
      {%- assign tab_slug = tab.settings.tab_id -%}
      <div
        class="sp-faq__panel{% if forloop.first %} is-active{% endif %}"
        data-panel="{{ tab_slug | escape }}"
        role="tabpanel"
        {{ tab.shopify_attributes }}
      >
        {%- for item in item_blocks -%}
          {%- if item.settings.tab == tab_slug -%}
            <details class="sp-faq__item" {{ item.shopify_attributes }}>
              <summary>{{ item.settings.question }}</summary>
              <div class="sp-faq__answer">{{ item.settings.answer }}</div>
            </details>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endfor -%}

    {%- if tab_blocks.size == 0 -%}
      {%- comment -%}No tabs — render all items in one list.{%- endcomment -%}
      <div class="sp-faq__panel is-active">
        {%- for item in item_blocks -%}
          <details class="sp-faq__item" {{ item.shopify_attributes }}>
            <summary>{{ item.settings.question }}</summary>
            <div class="sp-faq__answer">{{ item.settings.answer }}</div>
          </details>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

<script>
  (function() {
    const root = document.getElementById('shopify-section-{{ section.id }}');
    if (!root) return;
    const tabs = root.querySelectorAll('.sp-faq__tab');
    const panels = root.querySelectorAll('.sp-faq__panel');
    tabs.forEach(function(tab) {
      tab.addEventListener('click', function() {
        const target = tab.getAttribute('data-tab');
        tabs.forEach(function(t) {
          t.classList.toggle('is-active', t === tab);
          t.setAttribute('aria-selected', t === tab ? 'true' : 'false');
        });
        panels.forEach(function(p) {
          p.classList.toggle('is-active', p.getAttribute('data-panel') === target);
        });
      });
    });
  })();
</script>

{% schema %}
{
  "name": "FAQ",
  "tag": "section",
  "class": "sp-faq-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "questions, asked honestly." },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "pad_top", "label": "Padding top", "min": 0, "max": 200, "step": 8, "unit": "px", "default": 96 },
    { "type": "range", "id": "pad_bottom", "label": "Padding bottom", "min": 0, "max": 200, "step": 8, "unit": "px", "default": 96 }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Tab",
      "settings": [
        { "type": "text", "id": "tab_id", "label": "Tab ID (slug, lowercase, no spaces)", "default": "product", "info": "Match this exactly in the FAQ items below." },
        { "type": "text", "id": "label", "label": "Tab label", "default": "product" }
      ]
    },
    {
      "type": "item",
      "name": "Item",
      "settings": [
        { "type": "text", "id": "tab", "label": "Tab ID this item belongs to", "default": "product" },
        { "type": "text", "id": "question", "label": "Question", "default": "is this HRT?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>no. soft pauses is not a hormone and not a drug. it is a daily plant-based support.</p>" }
      ]
    }
  ],
  "max_blocks": 50,
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        { "type": "tab", "settings": { "tab_id": "product", "label": "product" } },
        { "type": "tab", "settings": { "tab_id": "subscription", "label": "subscription" } },
        { "type": "tab", "settings": { "tab_id": "shipping", "label": "shipping & returns" } },
        { "type": "tab", "settings": { "tab_id": "medical", "label": "medical" } },
        { "type": "item", "settings": { "tab": "product", "question": "is this HRT?", "answer": "<p>no. soft pauses is not a hormone and not a drug. it is a daily plant-based support. if you are exploring HRT, we recommend finding a menopause-trained physician.</p>" } },
        { "type": "item", "settings": { "tab": "product", "question": "how long until i feel something?", "answer": "<p>most women report a difference in energy and mood within the first two to four weeks of daily use. give it a full 30 days.</p>" } },
        { "type": "item", "settings": { "tab": "product", "question": "why a patch and not a pill?", "answer": "<p>pills require a digestive system, a routine, and a memory. a patch is once a day, on the skin, done.</p>" } },
        { "type": "item", "settings": { "tab": "product", "question": "where do i wear the patch?", "answer": "<p>the inside of the forearm, the shoulder, or the upper hip work best. anywhere with thin, clean skin. rotate placement to avoid skin irritation.</p>" } },
        { "type": "item", "settings": { "tab": "subscription", "question": "how does the subscription work?", "answer": "<p>your first order ships free with 20% off. after that, you get a fresh 30-day supply every 30 days at the subscription price. pause, skip, or cancel anytime in one click.</p>" } },
        { "type": "item", "settings": { "tab": "subscription", "question": "how do i cancel?", "answer": "<p>log in, click cancel. it takes about 10 seconds. no phone calls, no chat queues.</p>" } },
        { "type": "item", "settings": { "tab": "subscription", "question": "can i pause or skip a month?", "answer": "<p>yes. pause for any reason, any length. skip a month, skip three. resume whenever you want.</p>" } },
        { "type": "item", "settings": { "tab": "shipping", "question": "when will my order ship?", "answer": "<p>orders placed before 1pm ET ship the same business day. delivery is typically 2–5 business days within the US.</p>" } },
        { "type": "item", "settings": { "tab": "shipping", "question": "do you ship internationally?", "answer": "<p>we ship within the US and Canada today. the EU and UK are on the roadmap for q3.</p>" } },
        { "type": "item", "settings": { "tab": "shipping", "question": "what if it doesn't work for me?", "answer": "<p>send it back within 30 days for a full refund. no questions, no forms, no friction.</p>" } },
        { "type": "item", "settings": { "tab": "medical", "question": "is maca safe for me?", "answer": "<p>maca has been used for centuries and is generally well-tolerated. if you are pregnant, breastfeeding, on thyroid medication, or being treated for a hormone-sensitive condition, please talk to your doctor before starting.</p>" } },
        { "type": "item", "settings": { "tab": "medical", "question": "can i take this with HRT?", "answer": "<p>most women on HRT can use soft pauses as a daily floor of support. confirm with your prescribing physician first.</p>" } },
        { "type": "item", "settings": { "tab": "medical", "question": "are there side effects?", "answer": "<p>the most common is mild skin irritation at the patch site, usually from leaving the patch on the same spot. rotate placement and it typically resolves.</p>" } },
        { "type": "item", "settings": { "tab": "medical", "question": "is this hsa/fsa eligible?", "answer": "<p>yes, with a letter of medical necessity through truemed (free, takes about 5 minutes at checkout).</p>" } }
      ]
    }
  ]
}
{% endschema %}
