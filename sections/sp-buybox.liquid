{%- comment -%}
  SoftPauses buy box. Conversion engine.
  - Auto-discovers product variants for the quantity tier selector.
  - Auto-discovers selling plans for subscribe & save.
  - Falls back to simple add-to-cart if either is missing.

  To get the design's "1 month / 3 months / 6 months" qty tiers, set up
  three variants on your product (e.g. "1 Month Supply", "3 Month Supply",
  "6 Month Supply"). Their order in the variant array drives display order.
{%- endcomment -%}

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign has_variants = false
  if product != blank and product.variants.size > 1
    assign has_variants = true
  endif
  assign has_subscription = false
  if product != blank and product.selling_plan_groups.size > 0
    assign has_subscription = true
    assign first_sp_group = product.selling_plan_groups.first
    assign first_sp = first_sp_group.selling_plans.first
  endif
-%}

<style>
  #shopify-section-{{ section.id }} { background: var(--sp-blush-soft); }
  .sp-bb { padding-top: var(--sp-pad-top, 96px); padding-bottom: var(--sp-pad-bottom, 96px); }
  @media (max-width: 720px) { .sp-bb { padding-top: 64px; padding-bottom: 64px; } }

  .sp-bb__head {
    text-align: center;
    margin-bottom: 36px;
  }
  .sp-bb__head h2 { margin-bottom: 14px; }
  .sp-bb__head p { color: var(--sp-ink-mid); max-width: 520px; margin: 0 auto; }

  .sp-bb__box {
    max-width: 520px;
    margin: 0 auto;
    background: var(--sp-cream);
    border-radius: 4px;
    padding: 36px 32px;
    border: 1px solid var(--sp-rule);
  }
  @media (max-width: 600px) { .sp-bb__box { padding: 28px 22px; } }
  .sp-bb__title {
    font-family: 'Fraunces', serif;
    font-size: 1.625rem;
    text-align: center;
    margin-bottom: 22px;
    color: var(--sp-ink);
    text-transform: lowercase;
    font-variation-settings: "opsz" 96;
  }

  .sp-bb__qty-row {
    display: flex;
    gap: 8px;
    margin-bottom: 20px;
  }
  .sp-bb__qty {
    flex: 1;
    padding: 14px 8px;
    background: var(--sp-cream);
    border: 1px solid var(--sp-rule);
    border-radius: 4px;
    text-align: center;
    cursor: pointer;
    transition: all 0.18s;
    font-family: 'IBM Plex Sans', sans-serif;
  }
  .sp-bb__qty:hover { border-color: var(--sp-coral); }
  .sp-bb__qty.is-active {
    border-color: var(--sp-poppy);
    background: var(--sp-blush);
  }
  .sp-bb__qty .q-label {
    font-family: 'Fraunces', serif;
    font-size: 1rem;
    color: var(--sp-ink);
    margin-bottom: 2px;
    text-transform: lowercase;
    font-variation-settings: "opsz" 72;
  }
  .sp-bb__qty .q-save {
    font-size: 10px;
    color: var(--sp-poppy);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-weight: 500;
  }

  .sp-bb__plan {
    display: block;
    padding: 18px 20px;
    border-radius: 4px;
    border: 1px solid var(--sp-rule);
    background: var(--sp-cream);
    margin-bottom: 10px;
    cursor: pointer;
    position: relative;
    transition: border 0.18s, background 0.18s;
  }
  .sp-bb__plan input { position: absolute; opacity: 0; pointer-events: none; }
  .sp-bb__plan:hover { border-color: var(--sp-coral); }
  .sp-bb__plan.is-active {
    border-color: var(--sp-poppy);
    background: var(--sp-blush);
  }
  .sp-bb__banner {
    position: absolute;
    top: -10px;
    left: 16px;
    background: var(--sp-poppy);
    color: var(--sp-cream);
    font-family: 'IBM Plex Sans', sans-serif;
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 4px 10px;
    border-radius: 2px;
  }
  .sp-bb__plan-top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
  }
  .sp-bb__plan-name {
    font-family: 'Fraunces', serif;
    font-size: 1.125rem;
    color: var(--sp-ink);
    line-height: 1.2;
    text-transform: lowercase;
    font-variation-settings: "opsz" 72;
  }
  .sp-bb__plan-price {
    font-family: 'Fraunces', serif;
    font-size: 1.25rem;
    color: var(--sp-ink);
    font-weight: 500;
    line-height: 1.2;
    flex-shrink: 0;
    font-variation-settings: "opsz" 72;
  }
  .sp-bb__plan-price .strike {
    color: var(--sp-ink-muted);
    text-decoration: line-through;
    font-size: 0.85rem;
    margin-right: 6px;
    font-weight: 400;
  }
  .sp-bb__plan-meta {
    margin-top: 8px;
    font-family: 'IBM Plex Sans', sans-serif;
    font-size: 13px;
    color: var(--sp-ink-mid);
    line-height: 1.5;
  }
  .sp-bb__plan-meta .pday { color: var(--sp-poppy); font-weight: 500; }

  .sp-bb__perks {
    margin-top: 10px;
    font-size: 12px;
    color: var(--sp-ink-mid);
    line-height: 1.6;
    font-family: 'IBM Plex Sans', sans-serif;
  }
  .sp-bb__perks span { display: block; }
  .sp-bb__perks span::before {
    content: "✓ ";
    color: var(--sp-poppy);
    margin-right: 4px;
  }

  .sp-bb__cta { margin-top: 8px; }

  .sp-bb__trust {
    margin-top: 16px;
    display: flex;
    justify-content: space-around;
    flex-wrap: wrap;
    gap: 14px;
    padding-top: 16px;
    border-top: 1px solid var(--sp-rule);
  }
  .sp-bb__trust-item {
    font-family: 'IBM Plex Sans', sans-serif;
    font-size: 11px;
    color: var(--sp-ink-mid);
    text-align: center;
    line-height: 1.4;
  }
  .sp-bb__trust-item strong {
    display: block;
    font-size: 12px;
    color: var(--sp-ink);
    font-weight: 500;
  }
</style>

<section class="sp-bb" id="{{ section.settings.anchor_id | default: 'offer' }}"
  style="--sp-pad-top: {{ section.settings.pad_top }}px; --sp-pad-bottom: {{ section.settings.pad_bottom }}px;">
  <div class="sp-wrap">
    <div class="sp-bb__head">
      {%- if section.settings.heading != blank -%}<h2 class="sp-h2">{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.lede != blank -%}<p>{{ section.settings.lede }}</p>{%- endif -%}
    </div>

    <div class="sp-bb__box" data-sp-buybox="{{ section.id }}">
      {%- if section.settings.box_title != blank -%}<div class="sp-bb__title">{{ section.settings.box_title }}</div>{%- endif -%}

      <form method="post" action="{{ routes.cart_add_url }}" enctype="multipart/form-data" novalidate>
        <input type="hidden" name="quantity" value="1">
        <input type="hidden" name="id" value="{{ current_variant.id }}" data-sp-variant-id>
        {%- if has_subscription -%}
          <input type="hidden" name="selling_plan" value="{{ first_sp.id }}" data-sp-selling-plan>
        {%- endif -%}

        {%- if has_variants -%}
          <div class="sp-bb__qty-row" role="radiogroup" aria-label="Supply">
            {%- for variant in product.variants -%}
              {%- assign save_label = '' -%}
              {%- if forloop.index == 2 -%}{%- assign save_label = section.settings.tier_2_save -%}{%- endif -%}
              {%- if forloop.index == 3 -%}{%- assign save_label = section.settings.tier_3_save -%}{%- endif -%}
              <button
                type="button"
                class="sp-bb__qty{% if variant.id == current_variant.id %} is-active{% endif %}"
                data-sp-qty="{{ variant.id }}"
                role="radio"
                aria-checked="{% if variant.id == current_variant.id %}true{% else %}false{% endif %}">
                <div class="q-label">{{ variant.title | downcase }}</div>
                {%- if save_label != blank -%}<div class="q-save">{{ save_label }}</div>{%- endif -%}
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- if has_subscription -%}
          <label class="sp-bb__plan is-active" data-sp-plan="{{ first_sp.id }}">
            {%- if section.settings.popular_banner != blank -%}<div class="sp-bb__banner">{{ section.settings.popular_banner }}</div>{%- endif -%}
            <input type="radio" name="plan" checked>
            <div class="sp-bb__plan-top">
              <div class="sp-bb__plan-name">{{ section.settings.subscribe_name | default: first_sp.name | downcase }}</div>
              <div class="sp-bb__plan-price">
                {%- if current_variant.compare_at_price > current_variant.price -%}
                  <span class="strike">{{ current_variant.compare_at_price | money_without_trailing_zeros }}</span>
                {%- endif -%}
                {{ current_variant.price | money_without_trailing_zeros }}
              </div>
            </div>
            {%- if section.settings.subscribe_meta != blank -%}<div class="sp-bb__plan-meta">{{ section.settings.subscribe_meta }}</div>{%- endif -%}
            <div class="sp-bb__perks">
              {%- if section.settings.perk_1 != blank -%}<span>{{ section.settings.perk_1 }}</span>{%- endif -%}
              {%- if section.settings.perk_2 != blank -%}<span>{{ section.settings.perk_2 }}</span>{%- endif -%}
              {%- if section.settings.perk_3 != blank -%}<span>{{ section.settings.perk_3 }}</span>{%- endif -%}
            </div>
          </label>

          <label class="sp-bb__plan" data-sp-plan="">
            <input type="radio" name="plan">
            <div class="sp-bb__plan-top">
              <div class="sp-bb__plan-name">{{ section.settings.onetime_name | default: 'one-time' }}</div>
              <div class="sp-bb__plan-price">{{ current_variant.price | money_without_trailing_zeros }}</div>
            </div>
            {%- if section.settings.onetime_meta != blank -%}<div class="sp-bb__plan-meta">{{ section.settings.onetime_meta }}</div>{%- endif -%}
          </label>
        {%- endif -%}

        <button type="submit" class="sp-btn sp-btn--block sp-btn--lg sp-bb__cta" {% if current_variant.available == false %}disabled{% endif %}>
          {%- if current_variant.available == false -%}sold out{%- else -%}{{ section.settings.cta_label | default: 'add to cart' }} &mdash; {{ current_variant.price | money_without_trailing_zeros }}{%- endif -%}
        </button>

        <div class="sp-bb__trust">
          {%- for block in section.blocks -%}
            {%- if block.type == 'trust' -%}
              <div class="sp-bb__trust-item" {{ block.shopify_attributes }}>
                <strong>{{ block.settings.headline }}</strong>
                {{ block.settings.subline }}
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </form>
    </div>
  </div>
</section>

<script>
  (function() {
    const root = document.querySelector('[data-sp-buybox="{{ section.id }}"]');
    if (!root) return;
    const variantInput = root.querySelector('[data-sp-variant-id]');
    const planInput = root.querySelector('[data-sp-selling-plan]');

    root.querySelectorAll('[data-sp-qty]').forEach(function(btn) {
      btn.addEventListener('click', function() {
        root.querySelectorAll('[data-sp-qty]').forEach(function(b) {
          b.classList.remove('is-active');
          b.setAttribute('aria-checked', 'false');
        });
        btn.classList.add('is-active');
        btn.setAttribute('aria-checked', 'true');
        if (variantInput) variantInput.value = btn.getAttribute('data-sp-qty');
      });
    });

    root.querySelectorAll('[data-sp-plan]').forEach(function(plan) {
      plan.addEventListener('click', function() {
        root.querySelectorAll('[data-sp-plan]').forEach(function(p) { p.classList.remove('is-active'); });
        plan.classList.add('is-active');
        const planVal = plan.getAttribute('data-sp-plan');
        if (planInput) {
          if (planVal) {
            planInput.value = planVal;
            planInput.disabled = false;
          } else {
            planInput.value = '';
            planInput.disabled = true;
          }
        }
        const radio = plan.querySelector('input[type="radio"]');
        if (radio) radio.checked = true;
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Buy box",
  "tag": "section",
  "class": "sp-buybox-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "start with 30 days." },
    { "type": "textarea", "id": "lede", "label": "Lede", "default": "two ways to start. cancel or pause anytime, in one click." },
    { "type": "text", "id": "box_title", "label": "Box title", "default": "the daily patch." },
    { "type": "text", "id": "anchor_id", "label": "Anchor ID (for sticky CTA scroll target)", "default": "offer" },
    { "type": "header", "content": "Quantity tier labels" },
    { "type": "text", "id": "tier_2_save", "label": "2nd tier savings tag", "default": "save 10%" },
    { "type": "text", "id": "tier_3_save", "label": "3rd tier savings tag", "default": "save 18%" },
    { "type": "header", "content": "Subscribe plan" },
    { "type": "text", "id": "popular_banner", "label": "Banner ('Most popular')", "default": "most popular" },
    { "type": "text", "id": "subscribe_name", "label": "Plan name (overrides Shopify selling plan name)", "default": "subscribe and save 20%" },
    { "type": "text", "id": "subscribe_meta", "label": "Plan meta line", "default": "30 patches every 30 days. <span class=\"pday\">$1.07/day.</span>" },
    { "type": "text", "id": "perk_1", "label": "Perk 1", "default": "free shipping, every order" },
    { "type": "text", "id": "perk_2", "label": "Perk 2", "default": "cancel or pause in one click" },
    { "type": "text", "id": "perk_3", "label": "Perk 3", "default": "30-day money-back guarantee" },
    { "type": "header", "content": "One-time plan" },
    { "type": "text", "id": "onetime_name", "label": "Plan name", "default": "one-time" },
    { "type": "text", "id": "onetime_meta", "label": "Plan meta line", "default": "30 patches, shipped once. <span class=\"pday\">$1.33/day.</span>" },
    { "type": "header", "content": "CTA" },
    { "type": "text", "id": "cta_label", "label": "Add to cart label", "default": "add to cart" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "pad_top", "label": "Padding top", "min": 0, "max": 200, "step": 8, "unit": "px", "default": 96 },
    { "type": "range", "id": "pad_bottom", "label": "Padding bottom", "min": 0, "max": 200, "step": 8, "unit": "px", "default": 96 }
  ],
  "blocks": [
    {
      "type": "trust",
      "name": "Trust badge",
      "settings": [
        { "type": "text", "id": "headline", "label": "Headline", "default": "30 days" },
        { "type": "text", "id": "subline", "label": "Subline", "default": "money-back" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Buy box",
      "blocks": [
        { "type": "trust", "settings": { "headline": "30 days", "subline": "money-back" } },
        { "type": "trust", "settings": { "headline": "HSA / FSA", "subline": "eligible" } },
        { "type": "trust", "settings": { "headline": "free", "subline": "shipping" } },
        { "type": "trust", "settings": { "headline": "cancel", "subline": "anytime" } }
      ]
    }
  ],
  "enabled_on": {
    "templates": ["product"]
  }
}
{% endschema %}
