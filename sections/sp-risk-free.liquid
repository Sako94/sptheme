{%- comment -%}
  SoftPauses risk-free / guarantee callout. Big card, three small badges.
{%- endcomment -%}

<style>
  #shopify-section-{{ section.id }} { background: var(--sp-cream); }
  .sp-risk { padding-top: var(--sp-pad-top, 64px); padding-bottom: var(--sp-pad-bottom, 64px); }
  @media (max-width: 720px) { .sp-risk { padding-top: 48px; padding-bottom: 48px; } }
  .sp-risk__card {
    background: var(--sp-blush);
    border-radius: 4px;
    padding: 48px 40px;
    text-align: center;
    max-width: 720px;
    margin: 0 auto;
  }
  @media (max-width: 600px) { .sp-risk__card { padding: 36px 24px; } }
  .sp-risk__tag {
    font-family: 'IBM Plex Sans', sans-serif;
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--sp-poppy);
    margin-bottom: 14px;
    font-weight: 500;
  }
  .sp-risk__card h3 {
    font-family: 'Fraunces', serif;
    font-size: clamp(1.875rem, 4vw, 2.5rem);
    margin-bottom: 14px;
    text-transform: lowercase;
    color: var(--sp-ink);
    font-weight: 400;
    line-height: 1.05;
    font-variation-settings: "opsz" 144;
  }
  .sp-risk__card p {
    color: var(--sp-ink-mid);
    max-width: 480px;
    margin: 0 auto 26px;
    font-family: 'IBM Plex Sans', sans-serif;
  }
  .sp-risk__badges {
    display: flex;
    gap: 14px;
    justify-content: center;
    flex-wrap: wrap;
  }
  .sp-risk__badge {
    background: var(--sp-cream);
    padding: 14px 22px;
    border-radius: 4px;
    font-family: 'IBM Plex Sans', sans-serif;
    font-size: 13px;
    color: var(--sp-ink);
    line-height: 1.4;
  }
  .sp-risk__badge strong {
    display: block;
    font-family: 'Fraunces', serif;
    font-size: 1.0625rem;
    color: var(--sp-poppy);
    margin-bottom: 2px;
    font-variation-settings: "opsz" 72;
    font-weight: 500;
    text-transform: lowercase;
  }
</style>

<section class="sp-risk"
  style="--sp-pad-top: {{ section.settings.pad_top }}px; --sp-pad-bottom: {{ section.settings.pad_bottom }}px;">
  <div class="sp-wrap">
    <div class="sp-risk__card">
      {%- if section.settings.tag != blank -%}<div class="sp-risk__tag">{{ section.settings.tag }}</div>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h3>{{ section.settings.heading }}</h3>{%- endif -%}
      {%- if section.settings.body != blank -%}<p>{{ section.settings.body }}</p>{%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <div class="sp-risk__badges">
          {%- for block in section.blocks -%}
            {%- if block.type == 'badge' -%}
              <div class="sp-risk__badge" {{ block.shopify_attributes }}>
                <strong>{{ block.settings.headline }}</strong>
                {{ block.settings.subline }}
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Risk-free guarantee",
  "tag": "section",
  "class": "sp-risk-free-section",
  "settings": [
    { "type": "text", "id": "tag", "label": "Eyebrow tag", "default": "our promise" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "try it for 30 days. on us." },
    { "type": "textarea", "id": "body", "label": "Body", "default": "if it does not feel like it is doing something for you, send it back. no questions, no forms, no friction. that's the offer." },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "pad_top", "label": "Padding top", "min": 0, "max": 200, "step": 8, "unit": "px", "default": 64 },
    { "type": "range", "id": "pad_bottom", "label": "Padding bottom", "min": 0, "max": 200, "step": 8, "unit": "px", "default": 64 }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Badge",
      "settings": [
        { "type": "text", "id": "headline", "label": "Headline", "default": "30 days" },
        { "type": "text", "id": "subline", "label": "Subline", "default": "full refund" }
      ]
    }
  ],
  "max_blocks": 5,
  "presets": [
    {
      "name": "Risk-free",
      "blocks": [
        { "type": "badge", "settings": { "headline": "30 days", "subline": "full refund" } },
        { "type": "badge", "settings": { "headline": "HSA / FSA", "subline": "eligible via truemed" } },
        { "type": "badge", "settings": { "headline": "free shipping", "subline": "every order" } }
      ]
    }
  ]
}
{% endschema %}
