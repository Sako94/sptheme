{%- comment -%}
  SoftPauses press logo strip. Each block is a logo: either an uploaded
  image OR styled text (typography substitute). Image takes precedence.
{%- endcomment -%}

<style>
  #shopify-section-{{ section.id }} { background: var(--sp-cream); }
  .sp-press { padding-top: var(--sp-pad-top, 56px); padding-bottom: var(--sp-pad-bottom, 56px); }
  @media (max-width: 720px) { .sp-press { padding-top: 40px; padding-bottom: 40px; } }
  .sp-press__label {
    text-align: center;
    font-family: 'IBM Plex Sans', sans-serif;
    font-size: 11px;
    color: var(--sp-ink-muted);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    margin-bottom: 24px;
  }
  .sp-press__strip {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 24px;
    align-items: center;
  }
  @media (max-width: 720px) { .sp-press__strip { grid-template-columns: repeat(2, 1fr); gap: 22px; } }
  .sp-press__logo {
    text-align: center;
    color: var(--sp-ink-muted);
    opacity: 0.75;
  }
  .sp-press__logo img {
    max-width: 140px;
    max-height: 36px;
    margin: 0 auto;
    object-fit: contain;
    filter: grayscale(1);
  }
  .sp-press__logo .text-italic {
    font-family: 'Fraunces', serif;
    font-size: 17px;
    letter-spacing: 0.02em;
    font-style: italic;
    font-variation-settings: "opsz" 96;
  }
  .sp-press__logo .text-serif {
    font-family: 'Fraunces', serif;
    font-size: 17px;
    font-weight: 500;
    letter-spacing: -0.02em;
    font-variation-settings: "opsz" 96;
  }
  .sp-press__logo .text-allcaps {
    font-family: 'IBM Plex Sans', sans-serif;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }
</style>

<section class="sp-press"
  style="--sp-pad-top: {{ section.settings.pad_top }}px; --sp-pad-bottom: {{ section.settings.pad_bottom }}px;">
  <div class="sp-wrap">
    {%- if section.settings.label != blank -%}<p class="sp-press__label">{{ section.settings.label }}</p>{%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="sp-press__strip">
        {%- for block in section.blocks -%}
          {%- if block.type == 'logo' -%}
            <div class="sp-press__logo" {{ block.shopify_attributes }}>
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 280 | image_tag:
                  loading: 'lazy',
                  alt: block.settings.image.alt | default: block.settings.name
                }}
              {%- else -%}
                <span class="text-{{ block.settings.style | default: 'italic' }}">{{ block.settings.name }}</span>
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Press strip",
  "tag": "section",
  "class": "sp-press-section",
  "settings": [
    { "type": "text", "id": "label", "label": "Label", "default": "as featured in" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "pad_top", "label": "Padding top", "min": 0, "max": 200, "step": 8, "unit": "px", "default": 56 },
    { "type": "range", "id": "pad_bottom", "label": "Padding bottom", "min": 0, "max": 200, "step": 8, "unit": "px", "default": 56 }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Press logo",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Logo image (overrides text)" },
        { "type": "text", "id": "name", "label": "Publication name (text fallback)", "default": "Vogue" },
        {
          "type": "select",
          "id": "style",
          "label": "Text style (when no image)",
          "options": [
            { "value": "italic", "label": "Serif italic (Vogue style)" },
            { "value": "serif", "label": "Serif bold (Women's Health style)" },
            { "value": "allcaps", "label": "Sans all-caps (Forbes/Goop style)" }
          ],
          "default": "italic"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Press strip",
      "blocks": [
        { "type": "logo", "settings": { "name": "Women's Health", "style": "serif" } },
        { "type": "logo", "settings": { "name": "Vogue", "style": "italic" } },
        { "type": "logo", "settings": { "name": "FORBES", "style": "allcaps" } },
        { "type": "logo", "settings": { "name": "The Cut", "style": "italic" } },
        { "type": "logo", "settings": { "name": "GOOP", "style": "allcaps" } }
      ]
    }
  ]
}
{% endschema %}
