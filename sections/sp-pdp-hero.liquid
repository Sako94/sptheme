{%- comment -%}
  SoftPauses PDP hero. Pulls product data when on a product template;
  falls back to merchant-supplied placeholder content otherwise.
  CTA can either jump to an in-page anchor (e.g. #offer) or add to cart
  directly using the first available variant + first subscription selling plan.
{%- endcomment -%}

{%- liquid
  assign product = product
  assign current_variant = product.selected_or_first_available_variant
  assign has_subscription = false
  if product != blank and product.selling_plan_groups.size > 0
    assign has_subscription = true
    assign first_sp_group = product.selling_plan_groups.first
    assign first_sp = first_sp_group.selling_plans.first
  endif
-%}

<style>
  #shopify-section-{{ section.id }} { background: var(--sp-cream); }
  .sp-hero { padding: 56px 0 72px; }
  @media (max-width: 900px) { .sp-hero { padding: 36px 0 56px; } }
  .sp-hero__grid {
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    gap: 64px;
    align-items: center;
  }
  @media (max-width: 900px) { .sp-hero__grid { grid-template-columns: 1fr; gap: 36px; } }

  .sp-hero h1 { margin-bottom: 22px; }

  .sp-hero__pricing {
    font-family: 'Fraunces', serif;
    font-size: 1.0625rem;
    color: var(--sp-poppy);
    margin-bottom: 16px;
    font-variation-settings: "opsz" 72;
  }
  .sp-hero__pricing .num {
    font-size: 1.5rem;
    font-weight: 500;
    margin-right: 4px;
  }

  .sp-hero .sp-lede { margin-bottom: 30px; max-width: 540px; }
  .sp-hero .sp-lede strong { color: var(--sp-ink); font-weight: 500; }

  .sp-hero__cta-row {
    display: flex;
    align-items: center;
    gap: 18px;
    flex-wrap: wrap;
    margin-bottom: 18px;
  }
  .sp-hero__fineprint {
    font-family: 'IBM Plex Sans', sans-serif;
    font-size: 13px;
    color: var(--sp-ink-muted);
  }
  .sp-hero__fineprint .dot { margin: 0 8px; opacity: 0.5; }

  .sp-hero__trust {
    margin-top: 30px;
    padding-top: 22px;
    border-top: 1px solid var(--sp-rule);
    display: flex;
    gap: 28px;
    flex-wrap: wrap;
  }
  .sp-hero__trust-item {
    font-family: 'IBM Plex Sans', sans-serif;
    font-size: 12px;
    color: var(--sp-ink-mid);
    line-height: 1.4;
  }
  .sp-hero__trust-item strong {
    display: block;
    font-size: 13px;
    font-weight: 500;
    color: var(--sp-ink);
    margin-bottom: 2px;
  }

  .sp-hero__media {
    aspect-ratio: 4 / 5;
    background:
      radial-gradient(ellipse at 30% 70%, rgba(254, 117, 111, 0.35), transparent 55%),
      radial-gradient(ellipse at 80% 20%, rgba(254, 217, 209, 0.6), transparent 50%),
      var(--sp-cream-deep);
    border-radius: 4px;
    overflow: hidden;
    position: relative;
    display: flex;
    align-items: flex-end;
  }
  .sp-hero__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .sp-hero__media .sp-hero__placeholder {
    position: relative;
    z-index: 2;
    background: rgba(250, 241, 234, 0.92);
    backdrop-filter: blur(4px);
    padding: 12px 16px;
    margin: 28px;
    border-radius: 2px;
    font-family: 'IBM Plex Sans', sans-serif;
    font-size: 11px;
    color: var(--sp-ink-mid);
    letter-spacing: 0.02em;
    line-height: 1.5;
    max-width: 280px;
  }
</style>

<section class="sp-hero" id="offer">
  <div class="sp-wrap">
    <div class="sp-hero__grid">
      <div>
        {%- if section.settings.pricing_text != blank -%}
          <div class="sp-hero__pricing sp-rise">
            {%- if section.settings.pricing_amount != blank -%}<span class="num">{{ section.settings.pricing_amount }}</span>{%- endif -%}
            {{ section.settings.pricing_text }}
          </div>
        {%- endif -%}

        <h1 class="sp-h1 sp-rise">{{ section.settings.headline }}</h1>

        {%- if section.settings.lede != blank -%}
          <div class="sp-lede sp-rise">{{ section.settings.lede }}</div>
        {%- endif -%}

        <div class="sp-hero__cta-row sp-rise">
          {%- if section.settings.cta_action == 'add_to_cart' and product != blank -%}
            <form method="post" action="{{ routes.cart_add_url }}" enctype="multipart/form-data" novalidate>
              <input type="hidden" name="id" value="{{ current_variant.id }}">
              {%- if has_subscription -%}<input type="hidden" name="selling_plan" value="{{ first_sp.id }}">{%- endif -%}
              <input type="hidden" name="quantity" value="1">
              <button type="submit" class="sp-btn sp-btn--lg" {% if current_variant.available == false %}disabled{% endif %}>
                {%- if current_variant.available == false -%}
                  sold out
                {%- else -%}
                  {{ section.settings.cta_label | default: 'add to cart' }}
                {%- endif -%}
              </button>
            </form>
          {%- else -%}
            <a href="{{ section.settings.cta_anchor | default: '#offer' }}" class="sp-btn sp-btn--lg">{{ section.settings.cta_label | default: 'try soft pauses' }}</a>
          {%- endif -%}

          {%- if section.settings.fineprint != blank -%}
            <span class="sp-hero__fineprint">{{ section.settings.fineprint }}</span>
          {%- endif -%}
        </div>

        {%- if section.blocks.size > 0 -%}
          <div class="sp-hero__trust sp-rise">
            {%- for block in section.blocks -%}
              {%- if block.type == 'trust' -%}
                <div class="sp-hero__trust-item" {{ block.shopify_attributes }}>
                  <strong>{{ block.settings.headline }}</strong>
                  {{ block.settings.subline }}
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      <div class="sp-hero__media sp-rise">
        {%- if section.settings.image != blank -%}
          {%- assign img = section.settings.image -%}
          {{ img | image_url: width: 1200 | image_tag:
            loading: 'eager',
            fetchpriority: 'high',
            sizes: '(min-width: 900px) 540px, 100vw',
            widths: '480, 720, 1080, 1440',
            alt: img.alt | default: product.title | default: 'SoftPauses'
          }}
        {%- elsif product.featured_image != blank -%}
          {{ product.featured_image | image_url: width: 1200 | image_tag:
            loading: 'eager',
            fetchpriority: 'high',
            sizes: '(min-width: 900px) 540px, 100vw',
            widths: '480, 720, 1080, 1440',
            alt: product.featured_image.alt | default: product.title
          }}
        {%- else -%}
          <div class="sp-hero__placeholder">
            hero image placeholder<br>
            connect a product or set a section image to replace this.
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "PDP hero",
  "tag": "section",
  "class": "sp-pdp-hero-section",
  "settings": [
    {
      "type": "header",
      "content": "Pricing line"
    },
    {
      "type": "text",
      "id": "pricing_amount",
      "label": "Amount (large)",
      "default": "$1.07"
    },
    {
      "type": "text",
      "id": "pricing_text",
      "label": "Pricing text (after amount)",
      "default": "/day on subscribe and save"
    },
    {
      "type": "header",
      "content": "Copy"
    },
    {
      "type": "inline_richtext",
      "id": "headline",
      "label": "Headline (use <em>italic</em> for emphasis)",
      "default": "you're not losing your mind. you're losing your <em>estrogen</em>."
    },
    {
      "type": "richtext",
      "id": "lede",
      "label": "Lede paragraph",
      "default": "<p><strong>soft pauses is a daily patch for women in perimenopause.</strong> one patch a day. organic triple-source maca. not a drug. not HRT. just daily support, made simple.</p>"
    },
    {
      "type": "header",
      "content": "Call to action"
    },
    {
      "type": "select",
      "id": "cta_action",
      "label": "CTA action",
      "options": [
        { "value": "anchor", "label": "Scroll to anchor" },
        { "value": "add_to_cart", "label": "Add to cart" }
      ],
      "default": "anchor"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": "try soft pauses"
    },
    {
      "type": "text",
      "id": "cta_anchor",
      "label": "Anchor target (used when action is 'Scroll to anchor')",
      "default": "#offer"
    },
    {
      "type": "text",
      "id": "fineprint",
      "label": "CTA fineprint",
      "default": "$40 / 30-day supply · free shipping · 30-day returns"
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero image (override). Falls back to the product's featured image."
    }
  ],
  "blocks": [
    {
      "type": "trust",
      "name": "Trust item",
      "settings": [
        { "type": "text", "id": "headline", "label": "Headline", "default": "★ 4.8 / 5" },
        { "type": "text", "id": "subline", "label": "Subline", "default": "12,000+ verified reviews" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "PDP hero",
      "blocks": [
        { "type": "trust", "settings": { "headline": "★ 4.8 / 5", "subline": "12,000+ verified reviews" } },
        { "type": "trust", "settings": { "headline": "50,000+", "subline": "women in perimenopause" } },
        { "type": "trust", "settings": { "headline": "30 days", "subline": "money-back guarantee" } }
      ]
    }
  ],
  "enabled_on": {
    "templates": ["product"]
  }
}
{% endschema %}
