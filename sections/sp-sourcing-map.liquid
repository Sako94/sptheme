{%- comment -%}
  SoftPauses ingredient sourcing map. Stylized SVG of South America with the
  Andean highlands marked. Editable fact blocks (elevation, soil, etc.) on
  the right.
{%- endcomment -%}

<style>
  #shopify-section-{{ section.id }} { background: var(--sp-cream); }
  .sp-map { padding-top: var(--sp-pad-top, 96px); padding-bottom: var(--sp-pad-bottom, 96px); }
  @media (max-width: 720px) { .sp-map { padding-top: 64px; padding-bottom: 64px; } }
  .sp-map__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 56px;
    align-items: center;
    margin-top: 36px;
  }
  @media (max-width: 900px) { .sp-map__grid { grid-template-columns: 1fr; gap: 32px; } }

  .sp-map__diagram {
    background: var(--sp-blush-soft);
    border-radius: 4px;
    padding: 36px 28px;
    aspect-ratio: 4 / 5;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }
  .sp-map__diagram svg { width: 100%; height: auto; max-width: 360px; }
  .sp-map__caption {
    position: absolute;
    bottom: 28px;
    left: 50%;
    transform: translateX(-50%);
    background: var(--sp-cream);
    padding: 8px 14px;
    border-radius: 999px;
    font-family: 'Fraunces', serif;
    font-size: 12px;
    font-style: italic;
    color: var(--sp-ink);
    font-variation-settings: "opsz" 72;
    white-space: nowrap;
  }

  .sp-map__facts { display: grid; gap: 12px; }
  .sp-map__fact {
    background: var(--sp-cream);
    border: 1px solid var(--sp-rule);
    padding: 22px 24px;
    border-radius: 4px;
    display: grid;
    grid-template-columns: 100px 1fr;
    gap: 18px;
    align-items: baseline;
  }
  @media (max-width: 600px) { .sp-map__fact { grid-template-columns: 1fr; gap: 6px; } }
  .sp-map__num {
    font-family: 'Fraunces', serif;
    font-size: 1.875rem;
    color: var(--sp-poppy);
    line-height: 1;
    font-variation-settings: "opsz" 144;
  }
  .sp-map__num-unit {
    font-family: 'IBM Plex Sans', sans-serif;
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--sp-poppy);
    margin-top: 4px;
  }
  .sp-map__fact h4 {
    font-family: 'Fraunces', serif;
    font-size: 1rem;
    color: var(--sp-ink);
    margin-bottom: 4px;
    text-transform: lowercase;
    font-weight: 500;
    font-variation-settings: "opsz" 72;
  }
  .sp-map__fact p {
    font-family: 'IBM Plex Sans', sans-serif;
    font-size: 0.875rem;
    color: var(--sp-ink-mid);
    line-height: 1.5;
    margin: 0;
  }
</style>

<section class="sp-map"
  style="--sp-pad-top: {{ section.settings.pad_top }}px; --sp-pad-bottom: {{ section.settings.pad_bottom }}px;">
  <div class="sp-wrap sp-wrap--mid">
    {%- if section.settings.kicker != blank -%}<span class="sp-kicker">{{ section.settings.kicker }}</span>{%- endif -%}
    {%- if section.settings.heading != blank -%}<h2 class="sp-h2">{{ section.settings.heading }}</h2>{%- endif -%}
    {%- if section.settings.lede != blank -%}<div class="sp-lede">{{ section.settings.lede }}</div>{%- endif -%}

    <div class="sp-map__grid">
      <div class="sp-map__diagram">
        <svg viewBox="0 0 360 450" xmlns="http://www.w3.org/2000/svg" aria-label="Andean highlands sourcing map">
          <!-- Stylized South America silhouette (Peru-centered, simplified) -->
          <path d="M 180 50
                   C 195 60, 215 75, 220 95
                   C 225 115, 215 130, 220 145
                   C 230 165, 245 175, 250 195
                   C 260 220, 270 240, 270 270
                   C 270 295, 260 320, 245 345
                   C 230 370, 210 395, 195 410
                   C 185 420, 175 425, 165 420
                   C 150 410, 145 390, 140 370
                   C 132 350, 122 330, 115 305
                   C 110 285, 105 260, 110 240
                   C 115 220, 122 200, 125 180
                   C 128 160, 122 142, 130 125
                   C 138 105, 152 85, 165 70
                   C 172 60, 175 52, 180 50 Z"
                fill="#FED9D1" stroke="#FE756F" stroke-width="1.5" stroke-linejoin="round"/>

          <!-- Andes mountain range (highlighted band running down west side) -->
          <path d="M 145 85
                   C 142 110, 137 140, 130 175
                   C 122 215, 117 245, 122 280
                   C 127 315, 138 345, 148 375
                   C 155 395, 165 410, 175 415"
                fill="none" stroke="#ED1B28" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" opacity="0.85"/>

          <!-- Mountain peak texture marks -->
          <g fill="#C8121E" opacity="0.7">
            <polygon points="138,150 144,138 150,150"/>
            <polygon points="132,200 138,186 144,200"/>
            <polygon points="128,250 134,236 140,250"/>
            <polygon points="135,310 141,296 147,310"/>
          </g>

          <!-- Source pin (highlands of Peru) -->
          <g transform="translate(135 220)">
            <circle r="22" fill="#ED1B28" opacity="0.18"/>
            <circle r="14" fill="#ED1B28" opacity="0.32"/>
            <circle r="8" fill="#ED1B28"/>
            <circle r="3" fill="#FAF1EA"/>
          </g>

          <!-- Pin label callout -->
          <line x1="148" y1="220" x2="220" y2="200" stroke="#5C3A33" stroke-width="0.8" opacity="0.5"/>
          <text x="225" y="200" font-family="IBM Plex Sans, sans-serif" font-size="11" letter-spacing="1.5" fill="#2A1410" font-weight="500">JUNIN PLATEAU</text>
          <text x="225" y="216" font-family="Fraunces, serif" font-size="11" font-style="italic" fill="#5C3A33" font-variation-settings="'opsz' 72">14,000 ft elevation</text>

          <!-- Compass and decorative marks -->
          <g transform="translate(310 80)" opacity="0.55">
            <circle r="14" fill="none" stroke="#8A6E64" stroke-width="0.6"/>
            <line x1="0" y1="-10" x2="0" y2="10" stroke="#8A6E64" stroke-width="0.6"/>
            <line x1="-10" y1="0" x2="10" y2="0" stroke="#8A6E64" stroke-width="0.6"/>
            <text y="-18" text-anchor="middle" font-family="IBM Plex Sans, sans-serif" font-size="9" fill="#8A6E64">N</text>
          </g>
        </svg>
        {%- if section.settings.map_caption != blank -%}
          <div class="sp-map__caption">{{ section.settings.map_caption }}</div>
        {%- endif -%}
      </div>

      <div class="sp-map__facts">
        {%- for block in section.blocks -%}
          {%- if block.type == 'fact' -%}
            <div class="sp-map__fact" {{ block.shopify_attributes }}>
              <div>
                <div class="sp-map__num">{{ block.settings.num }}</div>
                {%- if block.settings.unit != blank -%}<div class="sp-map__num-unit">{{ block.settings.unit }}</div>{%- endif -%}
              </div>
              <div>
                {%- if block.settings.heading != blank -%}<h4>{{ block.settings.heading }}</h4>{%- endif -%}
                {%- if block.settings.body != blank -%}<p>{{ block.settings.body }}</p>{%- endif -%}
              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Sourcing map",
  "tag": "section",
  "class": "sp-sourcing-map-section",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "where it comes from" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "from the andean highlands. only." },
    { "type": "richtext", "id": "lede", "label": "Lede", "default": "<p>maca only grows well above 13,000 feet. the soil, sun, and cold are what give it its potency. we source from a single co-op of farmers in the peruvian andes who have been growing it the same way for generations.</p>" },
    { "type": "text", "id": "map_caption", "label": "Map caption", "default": "junin, peru" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "pad_top", "label": "Padding top", "min": 0, "max": 200, "step": 8, "unit": "px", "default": 96 },
    { "type": "range", "id": "pad_bottom", "label": "Padding bottom", "min": 0, "max": 200, "step": 8, "unit": "px", "default": 96 }
  ],
  "blocks": [
    {
      "type": "fact",
      "name": "Fact",
      "settings": [
        { "type": "text", "id": "num", "label": "Number / value", "default": "14,000" },
        { "type": "text", "id": "unit", "label": "Unit / kicker", "default": "FT ELEVATION" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "high-altitude grown" },
        { "type": "textarea", "id": "body", "label": "Body", "default": "the maca our farmers grow develops higher concentrations of the active glucosinolates that lowland varieties don't produce." }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Sourcing map",
      "blocks": [
        { "type": "fact", "settings": { "num": "14,000", "unit": "FT ELEVATION", "heading": "high-altitude grown", "body": "the maca our farmers grow develops higher concentrations of the active glucosinolates that lowland varieties don't produce." } },
        { "type": "fact", "settings": { "num": "100%", "unit": "USDA ORGANIC", "heading": "organic, certified", "body": "no synthetic pesticides, no GMOs, no irrigation runoff. just the same soil maca has been grown in for 2,000 years." } },
        { "type": "fact", "settings": { "num": "1", "unit": "SOURCE FARM CO-OP", "heading": "single origin", "body": "every patch traces back to one co-op of farmers in junin, peru. fair trade pricing, generational growers." } }
      ]
    }
  ]
}
{% endschema %}
