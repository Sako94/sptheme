{%- comment -%}
  SoftPauses timeline. 4 cards: day 1, week 2, month 1, month 3.
  Each card is a block with a "when" eyebrow, heading, and body.
{%- endcomment -%}

<style>
  #shopify-section-{{ section.id }} { background: var(--sp-cream); }
  .sp-tl { padding-top: var(--sp-pad-top, 96px); padding-bottom: var(--sp-pad-bottom, 96px); }
  @media (max-width: 720px) { .sp-tl { padding-top: 64px; padding-bottom: 64px; } }
  .sp-tl__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 14px;
    margin-top: 36px;
  }
  @media (max-width: 720px) { .sp-tl__grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 480px) { .sp-tl__grid { grid-template-columns: 1fr; } }
  .sp-tl__card {
    background: var(--sp-cream);
    padding: 28px 22px;
    border-radius: 4px;
    border-top: 2px solid var(--sp-poppy);
    border-left: 1px solid var(--sp-rule);
    border-right: 1px solid var(--sp-rule);
    border-bottom: 1px solid var(--sp-rule);
  }
  .sp-tl__card .when {
    font-family: 'IBM Plex Sans', sans-serif;
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--sp-poppy);
    margin-bottom: 12px;
    font-weight: 500;
  }
  .sp-tl__card h4 {
    font-family: 'Fraunces', serif;
    font-size: 1.1875rem;
    line-height: 1.25;
    margin-bottom: 10px;
    color: var(--sp-ink);
    text-transform: lowercase;
    font-weight: 400;
    font-variation-settings: "opsz" 96;
  }
  .sp-tl__card p {
    font-family: 'IBM Plex Sans', sans-serif;
    font-size: 0.875rem;
    color: var(--sp-ink-mid);
    line-height: 1.55;
    margin: 0;
  }
</style>

<section class="sp-tl"
  style="--sp-pad-top: {{ section.settings.pad_top }}px; --sp-pad-bottom: {{ section.settings.pad_bottom }}px;">
  <div class="sp-wrap">
    {%- if section.settings.chapter_label != blank or section.settings.chapter_num != blank -%}
      <div class="sp-chapter">
        <span class="sp-chapter__label">{{ section.settings.chapter_label }}</span>
        <span class="sp-chapter__num">{{ section.settings.chapter_num }}</span>
      </div>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}<h2 class="sp-h2">{{ section.settings.heading }}</h2>{%- endif -%}
    {%- if section.settings.lede != blank -%}<div class="sp-lede">{{ section.settings.lede }}</div>{%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="sp-tl__grid">
        {%- for block in section.blocks -%}
          {%- if block.type == 'milestone' -%}
            <div class="sp-tl__card" {{ block.shopify_attributes }}>
              {%- if block.settings.when != blank -%}<div class="when">{{ block.settings.when }}</div>{%- endif -%}
              {%- if block.settings.heading != blank -%}<h4>{{ block.settings.heading }}</h4>{%- endif -%}
              {%- if block.settings.body != blank -%}<p>{{ block.settings.body }}</p>{%- endif -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Timeline",
  "tag": "section",
  "class": "sp-timeline-section",
  "settings": [
    { "type": "text", "id": "chapter_label", "label": "Chapter label", "default": "what to expect" },
    { "type": "text", "id": "chapter_num", "label": "Chapter number", "default": "/ 07" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "perimenopause isn't linear. neither is the support." },
    { "type": "richtext", "id": "lede", "label": "Lede", "default": "<p>most women feel it in two to four weeks. some feel it on day one. some take longer. give it 30 days before deciding.</p>" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "pad_top", "label": "Padding top", "min": 0, "max": 200, "step": 8, "unit": "px", "default": 96 },
    { "type": "range", "id": "pad_bottom", "label": "Padding bottom", "min": 0, "max": 200, "step": 8, "unit": "px", "default": 96 }
  ],
  "blocks": [
    {
      "type": "milestone",
      "name": "Milestone",
      "settings": [
        { "type": "text", "id": "when", "label": "When (eyebrow)", "default": "day 1" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "first patch on." },
        { "type": "textarea", "id": "body", "label": "Body", "default": "peel, stick to the inside of your forearm or shoulder. wear it for 24 hours. swap it the next morning." }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Timeline",
      "blocks": [
        { "type": "milestone", "settings": { "when": "day 1", "heading": "first patch on.", "body": "peel, stick to the inside of your forearm or shoulder. wear it for 24 hours. swap it the next morning." } },
        { "type": "milestone", "settings": { "when": "week 2", "heading": "steadier mornings.", "body": "most women report fewer 3am wakings, less afternoon crash, and a quieter background buzz." } },
        { "type": "milestone", "settings": { "when": "month 1", "heading": "mood and energy reset.", "body": "the bigger shifts show up here. less rage out of nowhere. fewer days that feel like buffering." } },
        { "type": "milestone", "settings": { "when": "month 3", "heading": "your new baseline.", "body": "the patch becomes background. the routine is one decision a day. you stop noticing it. that's the point." } }
      ]
    }
  ]
}
{% endschema %}
