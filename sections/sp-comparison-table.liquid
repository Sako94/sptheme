{%- comment -%}
  SoftPauses comparison table. Three columns: brand + up to two competitors.
  Each row is a block. Cell content can be 'check', 'dash', or arbitrary text.
{%- endcomment -%}

<style>
  #shopify-section-{{ section.id }} { background: var(--sp-blush-soft); }
  .sp-vs { padding-top: var(--sp-pad-top, 96px); padding-bottom: var(--sp-pad-bottom, 96px); }
  @media (max-width: 720px) { .sp-vs { padding-top: 64px; padding-bottom: 64px; } }
  .sp-vs__wrap { margin-top: 36px; overflow-x: auto; }
  .sp-vs__table {
    width: 100%;
    border-collapse: collapse;
    background: var(--sp-cream);
    border-radius: 4px;
    overflow: hidden;
  }
  .sp-vs__table th, .sp-vs__table td {
    padding: 18px 14px;
    text-align: center;
    font-family: 'IBM Plex Sans', sans-serif;
    font-size: 14px;
    border-bottom: 1px solid var(--sp-rule);
  }
  .sp-vs__table th:first-child, .sp-vs__table td:first-child {
    text-align: left;
    font-family: 'Fraunces', serif;
    color: var(--sp-ink);
    font-size: 0.9375rem;
    font-variation-settings: "opsz" 72;
    width: 38%;
  }
  .sp-vs__table thead th {
    font-family: 'Fraunces', serif;
    font-size: 1rem;
    color: var(--sp-ink);
    background: var(--sp-blush);
    text-transform: lowercase;
    font-weight: 500;
    font-variation-settings: "opsz" 96;
  }
  .sp-vs__table thead th.is-us {
    background: var(--sp-poppy);
    color: var(--sp-cream);
  }
  .sp-vs__yes { color: var(--sp-poppy); font-size: 1.25rem; font-weight: 500; }
  .sp-vs__no { color: var(--sp-ink-muted); font-size: 1.25rem; }
  .sp-vs__text { color: var(--sp-ink-mid); font-size: 13px; }
  .sp-vs__table tr:last-child td { border-bottom: none; }
  @media (max-width: 600px) {
    .sp-vs__table th, .sp-vs__table td { padding: 12px 8px; font-size: 12.5px; }
    .sp-vs__table th:first-child, .sp-vs__table td:first-child { font-size: 13px; width: 44%; }
  }
</style>

<section class="sp-vs"
  style="--sp-pad-top: {{ section.settings.pad_top }}px; --sp-pad-bottom: {{ section.settings.pad_bottom }}px;">
  <div class="sp-wrap sp-wrap--mid">
    {%- if section.settings.chapter_label != blank or section.settings.chapter_num != blank -%}
      <div class="sp-chapter">
        <span class="sp-chapter__label">{{ section.settings.chapter_label }}</span>
        <span class="sp-chapter__num">{{ section.settings.chapter_num }}</span>
      </div>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}<h2 class="sp-h2">{{ section.settings.heading }}</h2>{%- endif -%}

    <div class="sp-vs__wrap">
      <table class="sp-vs__table">
        <thead>
          <tr>
            <th></th>
            <th class="is-us">{{ section.settings.us_column }}</th>
            {%- if section.settings.competitor_1 != blank -%}<th>{{ section.settings.competitor_1 }}</th>{%- endif -%}
            {%- if section.settings.competitor_2 != blank -%}<th>{{ section.settings.competitor_2 }}</th>{%- endif -%}
          </tr>
        </thead>
        <tbody>
          {%- for block in section.blocks -%}
            <tr {{ block.shopify_attributes }}>
              <td>{{ block.settings.feature }}</td>
              <td>
                {%- if block.settings.us_cell == 'check' -%}<span class="sp-vs__yes" aria-label="Yes">✓</span>
                {%- elsif block.settings.us_cell == 'dash' -%}<span class="sp-vs__no" aria-label="No">—</span>
                {%- else -%}<span class="sp-vs__text">{{ block.settings.us_cell }}</span>{%- endif -%}
              </td>
              {%- if section.settings.competitor_1 != blank -%}
                <td>
                  {%- if block.settings.c1_cell == 'check' -%}<span class="sp-vs__yes" aria-label="Yes">✓</span>
                  {%- elsif block.settings.c1_cell == 'dash' -%}<span class="sp-vs__no" aria-label="No">—</span>
                  {%- else -%}<span class="sp-vs__text">{{ block.settings.c1_cell }}</span>{%- endif -%}
                </td>
              {%- endif -%}
              {%- if section.settings.competitor_2 != blank -%}
                <td>
                  {%- if block.settings.c2_cell == 'check' -%}<span class="sp-vs__yes" aria-label="Yes">✓</span>
                  {%- elsif block.settings.c2_cell == 'dash' -%}<span class="sp-vs__no" aria-label="No">—</span>
                  {%- else -%}<span class="sp-vs__text">{{ block.settings.c2_cell }}</span>{%- endif -%}
                </td>
              {%- endif -%}
            </tr>
          {%- endfor -%}
        </tbody>
      </table>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Comparison table",
  "tag": "section",
  "class": "sp-comparison-section",
  "settings": [
    { "type": "text", "id": "chapter_label", "label": "Chapter label", "default": "how it compares" },
    { "type": "text", "id": "chapter_num", "label": "Chapter number", "default": "/ 06" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "soft pauses vs. typical perimenopause supplements." },
    { "type": "header", "content": "Columns" },
    { "type": "text", "id": "us_column", "label": "Brand column header", "default": "soft pauses" },
    { "type": "text", "id": "competitor_1", "label": "Competitor 1 header (leave blank to hide)", "default": "typical maca capsule" },
    { "type": "text", "id": "competitor_2", "label": "Competitor 2 header (leave blank to hide)", "default": "menopause blend" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "pad_top", "label": "Padding top", "min": 0, "max": 200, "step": 8, "unit": "px", "default": 96 },
    { "type": "range", "id": "pad_bottom", "label": "Padding bottom", "min": 0, "max": 200, "step": 8, "unit": "px", "default": 96 }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Row",
      "settings": [
        { "type": "text", "id": "feature", "label": "Feature (left column)", "default": "Feature name" },
        { "type": "paragraph", "content": "For each cell, type 'check' for a checkmark, 'dash' for a dash, or any text (e.g. 'varies')." },
        { "type": "text", "id": "us_cell", "label": "Soft Pauses cell", "default": "check" },
        { "type": "text", "id": "c1_cell", "label": "Competitor 1 cell", "default": "dash" },
        { "type": "text", "id": "c2_cell", "label": "Competitor 2 cell", "default": "dash" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Comparison table",
      "blocks": [
        { "type": "row", "settings": { "feature": "triple-source maca (black, red, yellow)", "us_cell": "check", "c1_cell": "single-source", "c2_cell": "often unspecified" } },
        { "type": "row", "settings": { "feature": "transdermal delivery (no pills)", "us_cell": "check", "c1_cell": "dash", "c2_cell": "dash" } },
        { "type": "row", "settings": { "feature": "black pepper extract for absorption", "us_cell": "check", "c1_cell": "dash", "c2_cell": "dash" } },
        { "type": "row", "settings": { "feature": "once daily, no food required", "us_cell": "check", "c1_cell": "2-3 capsules with food", "c2_cell": "varies" } },
        { "type": "row", "settings": { "feature": "vegan, sugar-free, latex-free", "us_cell": "check", "c1_cell": "varies", "c2_cell": "dash" } },
        { "type": "row", "settings": { "feature": "full ingredient transparency", "us_cell": "check", "c1_cell": "varies", "c2_cell": "dash" } },
        { "type": "row", "settings": { "feature": "30-day money-back guarantee", "us_cell": "check", "c1_cell": "dash", "c2_cell": "dash" } }
      ]
    }
  ]
}
{% endschema %}
