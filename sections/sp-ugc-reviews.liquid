{%- comment -%}
  SoftPauses UGC + reviews section. Three review cards (blocks) with
  image_picker for thumbnail, a star rating, quote, and attribution.
  Plus a star distribution panel pulled from section settings.
{%- endcomment -%}

<style>
  #shopify-section-{{ section.id }} { background: var(--sp-blush-soft); }
  .sp-ugc { padding-top: var(--sp-pad-top, 96px); padding-bottom: var(--sp-pad-bottom, 96px); }
  @media (max-width: 720px) { .sp-ugc { padding-top: 64px; padding-bottom: 64px; } }
  .sp-ugc__head {
    display: flex;
    justify-content: space-between;
    align-items: end;
    flex-wrap: wrap;
    gap: 20px;
    margin-bottom: 36px;
  }
  .sp-ugc__head h2 { margin-bottom: 0; }
  .sp-ugc__head .right { text-align: right; }
  @media (max-width: 600px) { .sp-ugc__head .right { text-align: left; } }
  .sp-ugc__stars {
    color: var(--sp-poppy);
    font-size: 1.25rem;
    letter-spacing: 0.05em;
  }
  .sp-ugc__rating-text {
    font-family: 'IBM Plex Sans', sans-serif;
    font-size: 13px;
    color: var(--sp-ink-mid);
    margin-top: 4px;
  }

  .sp-ugc__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
    margin-bottom: 36px;
  }
  @media (max-width: 720px) { .sp-ugc__grid { grid-template-columns: 1fr; } }
  .sp-ugc__card {
    background: var(--sp-cream);
    border-radius: 4px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }
  .sp-ugc__visual {
    aspect-ratio: 1 / 1;
    background:
      radial-gradient(ellipse at 30% 60%, rgba(254, 117, 111, 0.3), transparent 60%),
      radial-gradient(ellipse at 80% 20%, rgba(254, 217, 209, 0.5), transparent 50%),
      var(--sp-cream-deep);
    position: relative;
    overflow: hidden;
  }
  .sp-ugc__visual img {
    width: 100%; height: 100%; object-fit: cover; display: block;
  }
  .sp-ugc__play {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 56px;
    height: 56px;
    background: var(--sp-cream);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    text-decoration: none;
  }
  .sp-ugc__play::after {
    content: "";
    width: 0;
    height: 0;
    border-left: 16px solid var(--sp-poppy);
    border-top: 10px solid transparent;
    border-bottom: 10px solid transparent;
    margin-left: 4px;
  }
  .sp-ugc__body { padding: 22px 22px 24px; }
  .sp-ugc__body .stars {
    color: var(--sp-poppy);
    font-size: 0.875rem;
    margin-bottom: 8px;
    letter-spacing: 0.05em;
  }
  .sp-ugc__quote {
    font-family: 'Fraunces', serif;
    font-style: italic;
    font-size: 1.0625rem;
    line-height: 1.45;
    color: var(--sp-ink);
    margin-bottom: 14px;
    font-variation-settings: "opsz" 72;
  }
  .sp-ugc__attrib {
    font-family: 'IBM Plex Sans', sans-serif;
    font-size: 12px;
    color: var(--sp-ink-muted);
    letter-spacing: 0.02em;
  }
  .sp-ugc__attrib .verified {
    color: var(--sp-poppy);
    font-weight: 500;
    margin-right: 6px;
  }

  .sp-ugc__dist {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 28px;
    background: var(--sp-cream);
    padding: 28px 32px;
    border-radius: 4px;
    margin-bottom: 24px;
  }
  @media (max-width: 600px) {
    .sp-ugc__dist { grid-template-columns: 1fr; gap: 20px; padding: 24px 22px; }
  }
  .sp-ugc__dist-summary { text-align: center; }
  .sp-ugc__dist-summary .num {
    font-family: 'Fraunces', serif;
    font-size: 3.25rem;
    line-height: 1;
    color: var(--sp-poppy);
    margin-bottom: 6px;
    font-variation-settings: "opsz" 144;
  }
  .sp-ugc__dist-summary .stars {
    color: var(--sp-poppy);
    font-size: 1.125rem;
    margin-bottom: 4px;
    letter-spacing: 0.05em;
  }
  .sp-ugc__dist-summary .total {
    font-family: 'IBM Plex Sans', sans-serif;
    font-size: 12px;
    color: var(--sp-ink-muted);
  }
  .sp-ugc__dist-bars { display: flex; flex-direction: column; justify-content: center; gap: 6px; }
  .sp-ugc__dist-row {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: 'IBM Plex Sans', sans-serif;
    font-size: 11px;
    color: var(--sp-ink-mid);
  }
  .sp-ugc__dist-row .star-label { width: 30px; }
  .sp-ugc__dist-row .track {
    flex: 1;
    height: 8px;
    background: var(--sp-rule-soft);
    border-radius: 2px;
    overflow: hidden;
  }
  .sp-ugc__dist-row .fill {
    height: 100%;
    background: var(--sp-poppy);
    border-radius: 2px;
  }
  .sp-ugc__dist-row .pct { width: 38px; text-align: right; }

  .sp-ugc__foot {
    text-align: center;
    margin-top: 4px;
    font-family: 'IBM Plex Sans', sans-serif;
    font-size: 13px;
    color: var(--sp-ink-mid);
  }
</style>

<section class="sp-ugc"
  style="--sp-pad-top: {{ section.settings.pad_top }}px; --sp-pad-bottom: {{ section.settings.pad_bottom }}px;">
  <div class="sp-wrap">
    <div class="sp-ugc__head">
      <div>
        {%- if section.settings.kicker != blank -%}<div class="sp-kicker">{{ section.settings.kicker }}</div>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2 class="sp-h2">{{ section.settings.heading }}</h2>{%- endif -%}
      </div>
      <div class="right">
        <div class="sp-ugc__stars">★★★★★</div>
        {%- if section.settings.rating_text != blank -%}<div class="sp-ugc__rating-text">{{ section.settings.rating_text }}</div>{%- endif -%}
      </div>
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="sp-ugc__grid">
        {%- for block in section.blocks -%}
          {%- if block.type == 'review' -%}
            <div class="sp-ugc__card" {{ block.shopify_attributes }}>
              <div class="sp-ugc__visual">
                {%- if block.settings.image != blank -%}
                  {{ block.settings.image | image_url: width: 800 | image_tag:
                    loading: 'lazy',
                    sizes: '(min-width: 720px) 320px, 100vw',
                    widths: '320, 640, 800',
                    alt: block.settings.name
                  }}
                {%- elsif block.settings.fallback_asset != blank -%}
                  <img src="{{ block.settings.fallback_asset | asset_url }}"
                       alt="{{ block.settings.name }}"
                       width="800" height="800"
                       loading="lazy"
                       style="width: 100%; height: 100%; object-fit: cover; display: block;">
                {%- endif -%}
                {%- if block.settings.video_url != blank -%}
                  <a href="{{ block.settings.video_url }}" class="sp-ugc__play" target="_blank" rel="noopener" aria-label="Play review"></a>
                {%- endif -%}
              </div>
              <div class="sp-ugc__body">
                <div class="stars">★★★★★</div>
                <p class="sp-ugc__quote">{{ block.settings.quote }}</p>
                <div class="sp-ugc__attrib">
                  {%- if block.settings.verified -%}<span class="verified">✓ Verified</span>{%- endif -%}
                  {{ block.settings.name }}{%- if block.settings.age != blank -%}, {{ block.settings.age }}{%- endif -%}
                </div>
              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    <div class="sp-ugc__dist">
      <div class="sp-ugc__dist-summary">
        <div class="num">{{ section.settings.avg_rating | default: '4.8' }}</div>
        <div class="stars">★★★★★</div>
        <div class="total">{{ section.settings.total_text | default: 'based on 12,432 reviews' }}</div>
      </div>
      <div class="sp-ugc__dist-bars">
        <div class="sp-ugc__dist-row"><span class="star-label">5 ★</span><div class="track"><div class="fill" style="width: {{ section.settings.pct_5 | default: 88 }}%;"></div></div><span class="pct">{{ section.settings.pct_5 | default: 88 }}%</span></div>
        <div class="sp-ugc__dist-row"><span class="star-label">4 ★</span><div class="track"><div class="fill" style="width: {{ section.settings.pct_4 | default: 8 }}%;"></div></div><span class="pct">{{ section.settings.pct_4 | default: 8 }}%</span></div>
        <div class="sp-ugc__dist-row"><span class="star-label">3 ★</span><div class="track"><div class="fill" style="width: {{ section.settings.pct_3 | default: 3 }}%;"></div></div><span class="pct">{{ section.settings.pct_3 | default: 3 }}%</span></div>
        <div class="sp-ugc__dist-row"><span class="star-label">2 ★</span><div class="track"><div class="fill" style="width: {{ section.settings.pct_2 | default: 1 }}%;"></div></div><span class="pct">{{ section.settings.pct_2 | default: 1 }}%</span></div>
        <div class="sp-ugc__dist-row"><span class="star-label">1 ★</span><div class="track"><div class="fill" style="width: {{ section.settings.pct_1 | default: 0 }}%;"></div></div><span class="pct">&lt;1%</span></div>
      </div>
    </div>

    {%- if section.settings.foot != blank -%}<p class="sp-ugc__foot">{{ section.settings.foot }}</p>{%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "UGC reviews",
  "tag": "section",
  "class": "sp-ugc-reviews-section",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "what women are saying" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "12,000+ verified reviews." },
    { "type": "text", "id": "rating_text", "label": "Rating text (top right)", "default": "4.8 average · trustpilot verified" },
    { "type": "header", "content": "Distribution panel" },
    { "type": "text", "id": "avg_rating", "label": "Average rating (big number)", "default": "4.8" },
    { "type": "text", "id": "total_text", "label": "Total text", "default": "based on 12,432 reviews" },
    { "type": "range", "id": "pct_5", "label": "5-star %", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 88 },
    { "type": "range", "id": "pct_4", "label": "4-star %", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 8 },
    { "type": "range", "id": "pct_3", "label": "3-star %", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 3 },
    { "type": "range", "id": "pct_2", "label": "2-star %", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 1 },
    { "type": "range", "id": "pct_1", "label": "1-star %", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 0 },
    { "type": "richtext", "id": "foot", "label": "Footnote", "default": "<p><strong>customer favorite.</strong> less than 4% of customers return this product.</p>" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "pad_top", "label": "Padding top", "min": 0, "max": 200, "step": 8, "unit": "px", "default": 96 },
    { "type": "range", "id": "pad_bottom", "label": "Padding bottom", "min": 0, "max": 200, "step": 8, "unit": "px", "default": 96 }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Photo / video thumb (square ~1200x1200px)" },
        { "type": "text", "id": "fallback_asset", "label": "Fallback asset filename", "info": "Used if no image is uploaded above. Example: sp-ugc-1.png" },
        { "type": "url", "id": "video_url", "label": "Video URL (shows play button overlay)" },
        { "type": "textarea", "id": "quote", "label": "Quote", "default": "i feel like myself again. not a younger version. just myself." },
        { "type": "text", "id": "name", "label": "Name", "default": "sarah" },
        { "type": "text", "id": "age", "label": "Age", "default": "46" },
        { "type": "checkbox", "id": "verified", "label": "Verified buyer badge", "default": true }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "UGC reviews",
      "blocks": [
        { "type": "review", "settings": { "quote": "i feel like myself again. not a younger version. just myself.", "name": "sarah", "age": "46", "verified": true } },
        { "type": "review", "settings": { "quote": "my husband said you seem more like you. i burst into tears.", "name": "jen", "age": "44", "verified": true } },
        { "type": "review", "settings": { "quote": "i forgot what it felt like to have steady energy through the day. it came back slowly. then it just stayed.", "name": "maria", "age": "49", "verified": true } }
      ]
    }
  ]
}
{% endschema %}
